+    "x-mawadda-scanner-token": config.bearerToken,
+    "x-mawadda-media-id": "123e4567-e89b-12d3-a456-426614174000",
+    "x-mawadda-object-generation": "17",
+    "x-mawadda-expected-sha256": createHash("sha256").update(bytes).digest("hex"),
