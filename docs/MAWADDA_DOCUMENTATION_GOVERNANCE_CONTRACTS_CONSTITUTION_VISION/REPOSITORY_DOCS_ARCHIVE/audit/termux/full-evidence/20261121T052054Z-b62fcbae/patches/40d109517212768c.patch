+    bearerToken: "scanner-bearer-secret-".padEnd(48, "x"),
+    hmacSecret: "scanner-hmac-secret-".padEnd(48, "y"),
+    provider: "mawadda-malware-gateway",
+    callbackUrl,
+    maxBytes: 1024,
+    clamdHost: "127.0.0.1",
+    clamdPort: 3310,
+    clamdTimeoutMs: 1000,
+    callbackTimeoutMs: 2000,
+    ...overrides,
+  };
+}
