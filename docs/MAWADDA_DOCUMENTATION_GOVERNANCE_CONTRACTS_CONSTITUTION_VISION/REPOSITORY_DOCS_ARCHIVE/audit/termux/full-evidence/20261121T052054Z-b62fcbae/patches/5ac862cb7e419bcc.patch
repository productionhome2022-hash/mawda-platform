+export const PLATFORM_ROLE_IDS = {
+  superOwner: "super_admin",
+  generalAdmin: "platform_admin",
+  mediaAdmin: "ad_general_supervisor",
+  generalProductionSupervisor: "production_general_supervisor",
+  teamProductionSupervisor: "production_supervisor",
+} as const;
+
+/** Stable role IDs deliberately reuse the existing specialized-grant schema. */
+export type NumberedPlatformRole =
+  | "platform_admin"
+  | "ad_general_supervisor"
+  | "production_general_supervisor"
+  | "production_supervisor";
+
+export const PLATFORM_ROLE_CAPACITY: Record<NumberedPlatformRole, number | null> = {
+  platform_admin: null,
+  ad_general_supervisor: 5,
+  production_general_supervisor: 5,
+  production_supervisor: null,
+};
+
+/** Server-side seat guard. Call with the active count read in the same Firestore transaction. */
+export function assertPlatformRoleCapacity(role: NumberedPlatformRole, activeCountAfterWrite: number): void {
+  if (!Number.isSafeInteger(activeCountAfterWrite) || activeCountAfterWrite < 0) {
+    throw new Error("PLATFORM_ROLE_ACTIVE_COUNT_INVALID");
+  }
+  const capacity = PLATFORM_ROLE_CAPACITY[role];
+  if (capacity !== null && activeCountAfterWrite > capacity) {
+    throw new Error("PLATFORM_ROLE_CAPACITY_EXCEEDED");
+  }
+}
+
+export function platformRoleDisplayLabel(
+  role: NumberedPlatformRole,
+  ordinal: number,
+  locale: "ar" | "en" | "fr" | "es" = "en",
+): string {
+  if (!Number.isSafeInteger(ordinal) || ordinal < 1) {
+    throw new Error("PLATFORM_ROLE_ORDINAL_INVALID");
+  }
+  const capacity = PLATFORM_ROLE_CAPACITY[role];
+  if (capacity !== null && ordinal > capacity) {
+    throw new Error("PLATFORM_ROLE_CAPACITY_EXCEEDED");
+  }
+  const labels = {
+    platform_admin: { ar: "أدمن", en: "Admin", fr: "Administrateur", es: "Administrador" },
+    ad_general_supervisor: { ar: "أدمن ميديا", en: "Admin Media", fr: "Admin Média", es: "Admin Media" },
+    production_general_supervisor: {
+      ar: "مشرف إنتاج عام", en: "General Production Supervisor",
+      fr: "Superviseur général de production", es: "Supervisor general de producción",
+    },
+    production_supervisor: {
+      ar: "مشرف إنتاج الفريق", en: "Team Production Supervisor",
+      fr: "Superviseur de production d’équipe", es: "Supervisor de producción del equipo",
+    },
+  } as const;
+  const prefix = labels[role][locale];
+  // Team Production Supervisor is an open-ended role, but its canonical
+  // display title is unnumbered; keep any internal appointment sequence out
+  // of the member-facing label.
+  if (role === "production_supervisor") return prefix;
+  return locale === "ar" ? `${prefix} ${toArabicDigits(ordinal)}` : `${prefix} ${ordinal}`;
+}
+
+function toArabicDigits(value: number): string {
+  return String(value).replace(/[0-9]/g, (digit) => "٠١٢٣٤٥٦٧٨٩"[Number(digit)]);
+}
+
+/** Admin N is the only role with an approved permanent, never-reused sequence. */
+export function nextPermanentRoleOrdinal(
+  role: NumberedPlatformRole,
+  existingOrdinals: unknown[],
+): number {
+  if (role !== "platform_admin") {
+    throw new Error("PLATFORM_ROLE_SEQUENCE_POLICY_NOT_APPROVED");
+  }
+  let max = 0;
+  for (const value of existingOrdinals) {
+    if (!Number.isSafeInteger(value) || (value as number) < 1) {
+      throw new Error("PLATFORM_ROLE_HISTORY_INVALID");
+    }
+    max = Math.max(max, value as number);
+  }
+  return max + 1;
+}
diff --git a/functions/test/integration/specialized-role-capacity.integration.test.js b/functions/test/integration/specialized-role-capacity.integration.test.js
new file mode 100644
index 00000000..ad89dfe3
--- /dev/null
+++ b/functions/test/integration/specialized-role-capacity.integration.test.js
@@ -0,0 +1,120 @@
+const test = require("node:test");
+const assert = require("node:assert/strict");
+const { createHash } = require("node:crypto");
+const { getFirestore } = require("firebase-admin/firestore");
+const { setOwnerAdvertisingRoleGrant } = require("../../lib/index");
+
+const db = getFirestore();
+const ownerUid = "role_capacity_owner_0001";
+const now = Date.now();
+const ownerRequest = (data) => ({
+  data,
+  auth: {
+    uid: ownerUid,
+    token: {
+      platformOwner: true,
+      platformOwnerUid: ownerUid,
+      auth_time: Math.floor(Date.now() / 1000),
+      firebase: { sign_in_second_factor: "phone" },
+    },
+  },
+});
+const grantId = (uid, role) => createHash("sha256")
+  .update("specialized-role-v1|" + uid + "|" + role).digest("hex");
+const grant = (uid, role) => ({
+  uid,
+  role,
+  permissions: role === "production_supervisor" || role === "production_general_supervisor"
+    ? ["production.tasks.manage_assigned"]
+    : ["advertising.requests.view_all"],
+  resourceScopes: ["campaign:capacity-test"],
+  status: "active",
+  startsAtMs: now - 1000,
+  endsAtMs: null,
+  version: 1,
+});
+const seed = async (uid, role) => {
+  const id = grantId(uid, role);
+  await db.collection("specializedRoleGrants").doc(id).set(grant(uid, role));
+  return id;
+};
+const assign = (uid, role) => setOwnerAdvertisingRoleGrant.run(ownerRequest({
+  expectedVersion: 0,
+  grant: { ...grant(uid, role), version: undefined },
+}));
+
+test("Admin Media and general production supervisor assignments enforce five seats independently", async () => {
+  assert.ok(process.env.FIRESTORE_EMULATOR_HOST, "Firestore emulator is required");
+  const tag = Date.now().toString(36) + Math.random().toString(36).slice(2, 8);
+  const roles = ["ad_general_supervisor", "production_general_supervisor"];
+  const seeded = [];
+  const attempted = [];
+  try {
+    for (const role of roles) {
+      for (let i = 1; i <= 5; i += 1) {
+        seeded.push(await seed("member_" + role + "_" + tag + "_" + i, role));
+      }
+      const uid = "member_" + role + "_" + tag + "_sixth";
+      await assert.rejects(
+        () => assign(uid, role),
+        (error) => error && error.code === "resource-exhausted",
+      );
+      attempted.push(grantId(uid, role));
+      assert.equal((await db.collection("specializedRoleGrants")
+        .where("role", "==", role).where("status", "==", "active").get()).size, 5);
+    }
+  } finally {
+    await Promise.all([
+      ...[...seeded, ...attempted].map((id) =>
+        db.collection("specializedRoleGrants").doc(id).delete().catch(() => undefined)),
+      ...roles.map((role) =>
+        db.collection("specializedRoleSeatCounters").doc(role).delete().catch(() => undefined)),
+    ]);
+  }
+});
+
+test("concurrent owner assignments cannot oversubscribe the fifth Admin Media seat", async () => {
+  assert.ok(process.env.FIRESTORE_EMULATOR_HOST, "Firestore emulator is required");
+  const role = "ad_general_supervisor";
+  const tag = Date.now().toString(36) + Math.random().toString(36).slice(2, 8);
+  const seeded = [];
+  const candidates = ["candidate_a_" + tag, "candidate_b_" + tag];
+  const candidateIds = candidates.map((uid) => grantId(uid, role));
+  try {
+    for (let i = 1; i <= 4; i += 1) {
+      seeded.push(await seed("member_four_" + tag + "_" + i, role));
+    }
+    const outcomes = await Promise.allSettled(candidates.map((uid) => assign(uid, role)));
+    assert.equal(outcomes.filter((item) => item.status === "fulfilled").length, 1);
+    assert.equal(outcomes.filter((item) =>
+      item.status === "rejected" && item.reason?.code === "resource-exhausted").length, 1);
+    assert.equal((await db.collection("specializedRoleGrants")
+      .where("role", "==", role).where("status", "==", "active").get()).size, 5);
+  } finally {
+    await Promise.all([
+      ...[...seeded, ...candidateIds].map((id) =>
+        db.collection("specializedRoleGrants").doc(id).delete().catch(() => undefined)),
+      db.collection("specializedRoleSeatCounters").doc(role).delete().catch(() => undefined),
+    ]);
+  }
+});
+
+test("Team Production Supervisor remains open-ended", async () => {
+  assert.ok(process.env.FIRESTORE_EMULATOR_HOST, "Firestore emulator is required");
+  const role = "production_supervisor";
+  const tag = Date.now().toString(36) + Math.random().toString(36).slice(2, 8);
+  const ids = [];
+  try {
+    for (let i = 1; i <= 7; i += 1) {
+      const uid = "team_producer_" + tag + "_" + i;
+      const result = await assign(uid, role);
+      assert.equal(result.status, "active");
+      ids.push(grantId(uid, role));
+    }
+    assert.equal((await db.collection("specializedRoleGrants")
+      .where("role", "==", role).where("status", "==", "active").get()).size, 7);
+  } finally {
+    await Promise.all(ids.map((id) =>
+      db.collection("specializedRoleGrants").doc(id).delete().catch(() => undefined)));
+  }
+});
diff --git a/functions/test/platform-role-identities.test.js b/functions/test/platform-role-identities.test.js
new file mode 100644
index 00000000..5e4f2d7a
--- /dev/null
+++ b/functions/test/platform-role-identities.test.js
@@ -0,0 +1,50 @@
+const test = require("node:test");
+const assert = require("node:assert/strict");
+const {
+  PLATFORM_ROLE_IDS, PLATFORM_ROLE_CAPACITY, platformRoleDisplayLabel, nextPermanentRoleOrdinal, assertPlatformRoleCapacity,
+} = require("../lib/platform-role-identities");
+
+test("general Admin sequence is open-ended and monotonic", () => {
+  assert.equal(PLATFORM_ROLE_IDS.superOwner, "super_admin");
+  assert.equal(PLATFORM_ROLE_CAPACITY.platform_admin, null);
+  assert.equal(nextPermanentRoleOrdinal("platform_admin", [1, 2, 7]), 8);
+  assert.equal(platformRoleDisplayLabel("platform_admin", 8), "Admin 8");
+  assert.equal(platformRoleDisplayLabel("platform_admin", 2, "ar"), "أدمن ٢");
+});
+
+test("Admin Media and general production each have five independent seats", () => {
+  assert.equal(PLATFORM_ROLE_CAPACITY.ad_general_supervisor, 5);
+  assert.equal(PLATFORM_ROLE_CAPACITY.production_general_supervisor, 5);
+  assert.equal(platformRoleDisplayLabel("ad_general_supervisor", 1), "Admin Media 1");
+  assert.equal(platformRoleDisplayLabel("production_general_supervisor", 5, "ar"), "مشرف إنتاج عام ٥");
+  assert.throws(() => platformRoleDisplayLabel("ad_general_supervisor", 6), /CAPACITY_EXCEEDED/);
+});
+
+test("Team Production Supervisor is open-ended and distinct", () => {
+  assert.equal(PLATFORM_ROLE_CAPACITY.production_supervisor, null);
+  assert.equal(platformRoleDisplayLabel("production_supervisor", 12), "Team Production Supervisor");
+  assert.equal(platformRoleDisplayLabel("production_supervisor", 1, "ar"), "مشرف إنتاج الفريق");
+});
+
+test("role seat capacity guard blocks a sixth Admin Media or general production supervisor", () => {
+  assert.doesNotThrow(() => assertPlatformRoleCapacity("ad_general_supervisor", 5));
+  assert.doesNotThrow(() => assertPlatformRoleCapacity("production_general_supervisor", 5));
+  assert.throws(() => assertPlatformRoleCapacity("ad_general_supervisor", 6), /CAPACITY_EXCEEDED/);
+  assert.throws(() => assertPlatformRoleCapacity("production_general_supervisor", 6), /CAPACITY_EXCEEDED/);
+  assert.doesNotThrow(() => assertPlatformRoleCapacity("platform_admin", 1000));
+  assert.doesNotThrow(() => assertPlatformRoleCapacity("production_supervisor", 1000));
+  assert.throws(() => assertPlatformRoleCapacity("platform_admin", -1), /ACTIVE_COUNT_INVALID/);
+});
+
+test("Admin N sequence is permanent while fixed five-seat numbering reuse remains unresolved", () => {
+  assert.throws(() => nextPermanentRoleOrdinal("platform_admin", [1, 0]), /HISTORY_INVALID/);
+  assert.equal(nextPermanentRoleOrdinal("platform_admin", [1, 2, 4]), 5);
+  assert.throws(
+    () => nextPermanentRoleOrdinal("ad_general_supervisor", [1, 2]),
+    /SEQUENCE_POLICY_NOT_APPROVED/,
+  );
+  assert.throws(
+    () => nextPermanentRoleOrdinal("production_general_supervisor", [1, 2]),
+    /SEQUENCE_POLICY_NOT_APPROVED/,
+  );
+});
