   return {
     sequence,
     previousHash,
     eventHash: calculateOwnerAuditHash(event, sequence, previousHash),
     eventRef: CONTRACT_AUDIT_LOGS.doc(String(sequence).padStart(12, "0")),
     event,
   };
 }
