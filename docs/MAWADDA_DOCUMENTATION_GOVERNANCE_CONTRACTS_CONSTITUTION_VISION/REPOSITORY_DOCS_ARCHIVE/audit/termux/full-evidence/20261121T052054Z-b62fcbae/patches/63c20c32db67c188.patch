+  const member = value as Record<string, unknown>;
+  if (member.profileCompleted !== true || member.isBanned === true || member.isSuspended === true) return false;
+  if (member.accountStatus !== undefined && member.accountStatus !== "active") return false;
+  if (member.accountType === "guest" || member.isGuest === true || member.profileType === "guest") return false;
+  return true;
+}
+
+function readExpiryMs(value: unknown): number | null {
+  let result: unknown;
+  if (value instanceof Date) result = value.getTime();
+  else if (typeof value === "number") result = value;
+  else if (value !== null && typeof value === "object" &&
+      typeof (value as { toMillis?: unknown }).toMillis === "function") {
+    try { result = (value as { toMillis: () => number }).toMillis(); } catch { return null; }
+  } else return null;
+  return typeof result === "number" && Number.isSafeInteger(result) && result >= 0
+    ? result : null;
+}
+
+/**
+ * Timed gifts stack from max(server-now, current expiry). A permanent active
+ * entitlement remains permanent and is never shortened by a timed gift.
+ */
+export function calculateStoreGiftExpiryMs(
+  currentEntitlement: unknown,
+  durationDays: number | undefined,
+  nowMs: number,
+): number | null {
+  if (!Number.isSafeInteger(nowMs) || nowMs < 0) throw new Error("INVALID_SERVER_TIME");
+  if (durationDays !== undefined &&
+      (!Number.isSafeInteger(durationDays) || durationDays < 1 || durationDays > 3650)) {
+    throw new Error("INVALID_GIFT_DURATION");
+  }
+  const current = currentEntitlement !== null && typeof currentEntitlement === "object" &&
+    !Array.isArray(currentEntitlement) ? currentEntitlement as Record<string, unknown> : {};
+  const active = current.status === "active";
+  const currentExpiry = current.expiresAt;
+  if (active && (currentExpiry === null || currentExpiry === undefined)) return null;
+  if (durationDays === undefined) return null;
+  const existingExpiryMs = active ? readExpiryMs(currentExpiry) : 0;
+  if (active && existingExpiryMs === null) throw new Error("INVALID_CURRENT_ENTITLEMENT_EXPIRY");
+  if (active && existingExpiryMs !== null && existingExpiryMs <= nowMs) {
+    // Expired records do not contribute time to a new gift.
+    return nowMs + durationDays * 24 * 60 * 60 * 1000;
+  }
+  return Math.max(nowMs, existingExpiryMs ?? 0) + durationDays * 24 * 60 * 60 * 1000;
+}
diff --git a/functions/test/integration/store-gifting.integration.test.js b/functions/test/integration/store-gifting.integration.test.js
new file mode 100644
index 00000000..baabcfb3
--- /dev/null
+++ b/functions/test/integration/store-gifting.integration.test.js
@@ -0,0 +1,105 @@
+const test = require("node:test");
+const assert = require("node:assert/strict");
+const { getFirestore } = require("firebase-admin/firestore");
+const { createHash } = require("node:crypto");
+const { setStoreCatalogItem, giftStoreItem } = require("../../lib/index");
+
+const db = getFirestore();
+const ownerRequest = (uid, data) => ({
+  data, auth: { uid, token: {
+    platformOwner: true, platformOwnerUid: uid,
+    auth_time: Math.floor(Date.now() / 1000),
+    firebase: { sign_in_second_factor: "phone" },
+  } },
+});
+const memberRequest = (uid, data) => ({
+  data, auth: { uid, token: { firebase: { sign_in_provider: "password" } } },
+});
+const suffix = () => `${Date.now()}_${Math.random().toString(36).slice(2, 9)}`;
+
+test("store gift debits sender and grants recipient once with immutable terms", async () => {
+  assert.ok(process.env.FIRESTORE_EMULATOR_HOST, "Firestore emulator is required");
+  const tag = suffix();
+  const senderUid = `gift_sender_${tag}`;
+  const recipientUid = `gift_recipient_${tag}`;
+  const recipientUsername = `giftuser_${tag}`;
+  const itemId = `vip_gift_${tag}`;
+  const requestId = `gift_req_${tag}`;
+  const itemRef = db.collection("storeCatalog").doc(itemId);
+  const versionsRef = db.collection("storeCatalogVersions").doc(itemId).collection("versions");
+  const previousItem = await itemRef.get();
+  const previousVersions = await versionsRef.get();
+  const usernameRef = db.collection("usernameRegistry").doc(recipientUsername);
+  const previousUsername = await usernameRef.get();
+  const senderRef = db.collection("users").doc(senderUid);
+  const recipientRef = db.collection("users").doc(recipientUid);
+  const entitlementRef = recipientRef.collection("entitlements").doc(itemId);
+  const giftId = createHash("sha256").update(
+    `mawdda-store-gift-v1:${senderUid}:${requestId}`,
+  ).digest("hex");
+  const giftRef = db.collection("storeGifts").doc(giftId);
+  const ledgerRef = senderRef.collection("walletLedger").doc(`store_gift_${giftId}`);
+  const auditRef = db.collection("adminAuditLogs").doc(`store_gift_${giftId}`);
+
+  await Promise.all([
+    senderRef.set({ profileCompleted: true, accountStatus: "active", coins: 2000 }),
+    recipientRef.set({
+      profileCompleted: true, accountStatus: "active", username: recipientUsername, coins: 300,
+    }),
+    usernameRef.set({ uid: recipientUid, username: recipientUsername }),
+  ]);
+  try {
+    const saved = await setStoreCatalogItem.run(ownerRequest("gift-catalog-owner", {
+      itemId, name: "عضوية VIP", description: "استحقاق تجريبي للإهداء.",
+      category: "vip", priceCoins: 500, durationDays: 7,
+      sortOrder: 1, active: true, purchaseEnabled: true,
+    }));
+    const giftInput = {
+      recipientUsername, itemId, requestId,
+      expectedPriceCoins: 500, expectedCatalogVersion: saved.version,
+    };
+    const first = await giftStoreItem.run(memberRequest(senderUid, giftInput));
+    assert.equal(first.idempotentReplay, false);
+    assert.equal(first.priceCoins, 500);
+    assert.equal((await senderRef.get()).data().coins, 1500);
+    assert.equal((await recipientRef.get()).data().coins, 300,
+      "gift recipient is not charged");
+    const entitlement = await entitlementRef.get();
+    assert.equal(entitlement.data().giftedByUid, senderUid);
+    assert.equal(entitlement.data().catalogVersion, saved.version);
+    assert.equal(entitlement.data().expiresAt.toMillis(), first.expiresAt);
+    const ledger = await ledgerRef.get();
+    assert.equal(ledger.data().type, "store_gift_purchase");
+    assert.equal(ledger.data().amount, -500);
+
+    const replay = await giftStoreItem.run(memberRequest(senderUid, giftInput));
+    assert.equal(replay.idempotentReplay, true);
+    assert.equal((await senderRef.get()).data().coins, 1500);
+    await assert.rejects(
+      () => giftStoreItem.run(memberRequest(senderUid, {
+        ...giftInput, recipientUsername: "different_username",
+      })),
+      (error) => error && error.code === "already-exists",
+    );
+  } finally {
+    await Promise.all([
+      giftRef.delete().catch(() => undefined),
+      ledgerRef.delete().catch(() => undefined),
+      auditRef.delete().catch(() => undefined),
+      entitlementRef.delete().catch(() => undefined),
+      senderRef.delete().catch(() => undefined),
+      recipientRef.delete().catch(() => undefined),
+      (async () => {
+        await itemRef.delete().catch(() => undefined);
+        const versions = await versionsRef.get();
+        await Promise.all(versions.docs.map((doc) => doc.ref.delete()));
+        if (previousItem.exists) await itemRef.set(previousItem.data());
+        await Promise.all(previousVersions.docs.map((doc) => doc.ref.set(doc.data())));
+      })(),
+      (async () => {
+        await usernameRef.delete().catch(() => undefined);
+        if (previousUsername.exists) await usernameRef.set(previousUsername.data());
+      })(),
+    ]);
+  }
+});
diff --git a/functions/test/store-gifting.test.js b/functions/test/store-gifting.test.js
new file mode 100644
index 00000000..758c1ccd
--- /dev/null
+++ b/functions/test/store-gifting.test.js
@@ -0,0 +1,77 @@
+const test = require("node:test");
+const assert = require("node:assert/strict");
+const {
+  isStoreGiftReplayCompatible,
+  isEligibleStoreGiftMemberRecord,
+  calculateStoreGiftExpiryMs,
+} = require("../lib/store-gifting");
+
+const NOW = 1_800_000_000_000;
+
+test("gift replay is bound to sender, recipient, item, price and completed state", () => {
+  const prior = {
+    senderUid: "sender-a", recipientUid: "recipient-b",
+    itemId: "vip_monthly", priceCoins: 2500, catalogVersion: 3, status: "completed",
+  };
+  const identity = {
+    senderUid: "sender-a", recipientUid: "recipient-b",
+    itemId: "vip_monthly", expectedPriceCoins: 2500, expectedCatalogVersion: 3,
+  };
+  assert.equal(isStoreGiftReplayCompatible(prior, identity), true);
+  assert.equal(isStoreGiftReplayCompatible(prior, { ...identity, recipientUid: "recipient-c" }), false);
+  assert.equal(isStoreGiftReplayCompatible(prior, { ...identity, itemId: "other_item" }), false);
+  assert.equal(isStoreGiftReplayCompatible(prior, { ...identity, expectedPriceCoins: 3000 }), false);
+  assert.equal(isStoreGiftReplayCompatible(prior, { ...identity, expectedCatalogVersion: 4 }), false);
+  assert.equal(isStoreGiftReplayCompatible({ ...prior, status: "pending" }, identity), false);
+  assert.equal(isStoreGiftReplayCompatible(null, identity), false);
+});
+
+test("gift recipient eligibility requires a completed active non-guest member profile", () => {
+  assert.equal(isEligibleStoreGiftMemberRecord({ profileCompleted: true }), true);
+  assert.equal(isEligibleStoreGiftMemberRecord({ profileCompleted: true, accountStatus: "active" }), true);
+  assert.equal(isEligibleStoreGiftMemberRecord({ profileCompleted: false }), false);
+  assert.equal(isEligibleStoreGiftMemberRecord({ profileCompleted: true, accountStatus: "suspended" }), false);
+  assert.equal(isEligibleStoreGiftMemberRecord({ profileCompleted: true, accountType: "guest" }), false);
+  assert.equal(isEligibleStoreGiftMemberRecord({ profileCompleted: true, isGuest: true }), false);
+  assert.equal(isEligibleStoreGiftMemberRecord({ profileCompleted: true, profileType: "guest" }), false);
+  assert.equal(isEligibleStoreGiftMemberRecord(null), false);
+});
+
+test("timed gifts extend from the later of server now and active expiry", () => {
+  assert.equal(
+    calculateStoreGiftExpiryMs({ status: "active", expiresAt: { toMillis: () => NOW + 10_000 } }, 7, NOW),
+    NOW + 10_000 + 7 * 24 * 60 * 60 * 1000,
+  );
+  assert.equal(
+    calculateStoreGiftExpiryMs({ status: "active", expiresAt: { toMillis: () => NOW - 1 } }, 1, NOW),
+    NOW + 24 * 60 * 60 * 1000,
+  );
+  assert.equal(
+    calculateStoreGiftExpiryMs({ status: "expired", expiresAt: { toMillis: () => NOW + 50_000 } }, 1, NOW),
+    NOW + 24 * 60 * 60 * 1000,
+  );
+});
+
+test("a permanent active entitlement cannot be shortened by a timed gift", () => {
+  assert.equal(
+    calculateStoreGiftExpiryMs({ status: "active", expiresAt: null }, 30, NOW),
+    null,
+  );
+});
+
+test("permanent catalog items stay permanent and invalid durations fail closed", () => {
+  assert.equal(calculateStoreGiftExpiryMs({ status: "expired" }, undefined, NOW), null);
+  assert.throws(() => calculateStoreGiftExpiryMs({}, 0, NOW), /INVALID_GIFT_DURATION/);
+  assert.throws(() => calculateStoreGiftExpiryMs({}, 7, -1), /INVALID_SERVER_TIME/);
+});
+
+test("malformed active entitlement expiry fails closed instead of granting guessed time", () => {
+  assert.throws(
+    () => calculateStoreGiftExpiryMs({ status: "active", expiresAt: "not-a-timestamp" }, 7, NOW),
+    /INVALID_CURRENT_ENTITLEMENT_EXPIRY/,
+  );
+  assert.throws(
+    () => calculateStoreGiftExpiryMs({ status: "active", expiresAt: { toMillis: () => Number.NaN } }, 7, NOW),
+    /INVALID_CURRENT_ENTITLEMENT_EXPIRY/,
+  );
+});
