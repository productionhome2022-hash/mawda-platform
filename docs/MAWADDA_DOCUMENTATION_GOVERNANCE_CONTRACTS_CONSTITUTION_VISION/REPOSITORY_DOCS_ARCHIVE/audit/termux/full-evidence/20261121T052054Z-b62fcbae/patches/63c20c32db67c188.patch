 name: Validate Mawda
 
 on:
   # This workflow is new on the development branch and is not yet present on
   # main, so pull_request events cannot reliably load it for PR #2. Validate
   # every development-branch push directly; keep manual dispatch available.
   push:
     branches:
       - codex/mawda-full-platform-implementation
       - codex/governance-biometric-integration-2026-11-19
+      - codex/mawdda-economy-selective-port-2026-11-19
   workflow_dispatch:
 
 concurrency:
   # Keep only the newest validation for the development branch.
   group: mawda-validation-${{ github.ref_name }}
   cancel-in-progress: true
 
 permissions:
   contents: read
 
 jobs:
   flutter:
     name: Flutter analysis, tests and web build
     runs-on: ubuntu-latest
     timeout-minutes: 30
     steps:
       - uses: actions/checkout@v5
       - uses: subosito/flutter-action@v2
         with:
           flutter-version: "3.47.9"
           channel: stable
           cache: true
       - name: Install Flutter dependencies from the committed lockfile
         id: install_flutter_dependencies
         run: flutter pub get --enforce-lockfile
       - name: Upload resolved dependency lockfile for review
         uses: actions/upload-artifact@v7.0.2
         with:
           name: mawda-pubspec-lock-${{ github.sha }}
           path: pubspec.lock
           if-no-files-found: error
           retention-days: 7
       - name: Verify production and non-production Firebase project/app identities
         run: node functions/scripts/validate-firebase-config.cjs
       - name: Analyze Dart code
         run: flutter analyze
       - name: Run Flutter tests
         if: ${{ always() && steps.install_flutter_dependencies.outcome == 'success' }}
         run: flutter test
       - name: Validate desktop install experience assets
         if: ${{ always() && steps.install_flutter_dependencies.outcome == 'success' }}
         run: |
           node --check web/install-prompt.js
           node --check web/firebase-messaging-sw.js
           node <<'NODE'
           const fs = require('node:fs');
           const manifest = JSON.parse(fs.readFileSync('web/manifest.json', 'utf8'));
           if (manifest.name !== 'Mawdda Platform 2026' || manifest.display !== 'standalone' || !manifest.icons?.length) {
             throw new Error('PWA manifest identity, standalone display, or icons are invalid');
           }
           for (const file of [
             'web/mawdda-app-icon.svg',
             'web/icons/mawdda-192.svg',
             'web/icons/mawdda-512.svg',
             'web/install-prompt.js',
             'web/firebase-messaging-sw.js',
           ]) {
             if (!fs.existsSync(file)) throw new Error(`Required PWA asset is missing: ${file}`);
           }
           const serviceWorker = fs.readFileSync('web/firebase-messaging-sw.js', 'utf8');
           const iconMatch = serviceWorker.match(/icon:\s*['"]([^'"]+)['"]/);
           if (!iconMatch) throw new Error('Push notification icon path is missing');
           const iconPath = iconMatch[1].replace(/^\/+/, '');
           if (!fs.existsSync(`web/${iconPath}`)) throw new Error(`Push notification icon is missing: ${iconPath}`);
           console.log('PWA manifest, icons, service worker and install prompt validated');
           NODE
       - name: Build web release
         id: build_web
         if: ${{ always() && steps.install_flutter_dependencies.outcome == 'success' }}
         env:
           MAWDA_FCM_VAPID_KEY: ${{ vars.MAWDA_NONPROD_FCM_VAPID_KEY }}
         run: flutter build web --release --dart-define=MAWDA_FCM_VAPID_KEY="$MAWDA_FCM_VAPID_KEY"
       - name: Upload validated web build artifact
         if: ${{ always() && steps.build_web.outcome == 'success' }}
         uses: actions/upload-artifact@v7.0.2
         with:
           name: mawda-web-build-${{ github.sha }}
           path: build/web/
           if-no-files-found: error
           retention-days: 7
