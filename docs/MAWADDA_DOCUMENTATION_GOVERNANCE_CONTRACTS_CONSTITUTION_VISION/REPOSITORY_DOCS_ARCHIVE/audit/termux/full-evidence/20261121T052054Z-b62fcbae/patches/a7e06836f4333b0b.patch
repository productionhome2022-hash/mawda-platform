       !Number.isSafeInteger(data.agreedCoins) || (data.agreedCoins as number) < 1 ||
       (data.agreedCoins as number) > 1000000000 ||
       !Number.isSafeInteger(data.agreedPriceMinor) || (data.agreedPriceMinor as number) < 1 ||
