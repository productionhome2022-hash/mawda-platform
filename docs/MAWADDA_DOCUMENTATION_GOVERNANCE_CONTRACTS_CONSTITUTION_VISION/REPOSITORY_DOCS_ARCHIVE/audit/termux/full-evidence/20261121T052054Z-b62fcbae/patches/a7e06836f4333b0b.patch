+      audioCallsPerWindow: 5, videoCallsPerWindow: 3,
+      maxCallDurationMs: 60 * 1000,
+    },
+  });
+  await Promise.all(locks.map((lock) => lock.set({ callId, status: "active" })));
+  try {
