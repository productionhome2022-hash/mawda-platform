+      active: true, quotaWindowMs: 24 * 60 * 60 * 1000,
+      audioCallsPerWindow: 5, videoCallsPerWindow: 3,
+      maxCallDurationMs: 5 * 60 * 1000,
+    },
   });
   await Promise.all([
     callerLock.set({ callId, status: "active" }),
     calleeLock.set({ callId, status: "active" }),
