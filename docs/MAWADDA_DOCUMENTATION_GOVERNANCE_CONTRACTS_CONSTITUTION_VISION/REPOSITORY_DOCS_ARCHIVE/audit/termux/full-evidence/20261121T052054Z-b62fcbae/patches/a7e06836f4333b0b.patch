 }
 
 export function defaultAttendanceRewardPolicy(): AttendanceRewardPolicy {
   return {
     hourly: { enabled: false, amountCoins: 0 },
     daily: { enabled: false, amountCoins: 0 },
     weekly: { enabled: false, amountCoins: 0 },
   };
 }
 
 function pad(value: number): string {
   return String(value).padStart(2, "0");
 }
 
 /** UTC-only periods prevent device timezone and DST changes from multiplying claims. */
 export function utcRewardPeriod(type: AttendanceRewardType, nowMs: number): string {
   if (!Number.isSafeInteger(nowMs) || nowMs < 0) throw new Error("REWARD_TIME_INVALID");
   const date = new Date(nowMs);
   const year = date.getUTCFullYear();
   const month = pad(date.getUTCMonth() + 1);
   const day = pad(date.getUTCDate());
   if (type === "hourly") return `${year}${month}${day}T${pad(date.getUTCHours())}`;
   if (type === "daily") return `${year}${month}${day}`;
 
   // ISO-8601 week number and week-year, calculated in UTC.
   const isoDay = date.getUTCDay() || 7;
   const thursday = new Date(Date.UTC(year, date.getUTCMonth(), date.getUTCDate() + 4 - isoDay));
   const weekYear = thursday.getUTCFullYear();
   const firstThursday = new Date(Date.UTC(weekYear, 0, 4));
   const firstIsoDay = firstThursday.getUTCDay() || 7;
   firstThursday.setUTCDate(firstThursday.getUTCDate() + 4 - firstIsoDay);
   const week = 1 + Math.round((thursday.getTime() - firstThursday.getTime()) / 604800000);
   return `${weekYear}-W${pad(week)}`;
 }
 
 export function validateTimedAdCampaignInput(value: unknown): TimedAdCampaignInput {
   if (!value || typeof value !== "object" || Array.isArray(value)) {
     throw new Error("AD_CAMPAIGN_INVALID");
   }
   const input = value as Record<string, unknown>;
   const title = typeof input.title === "string" ? input.title.trim() : "";
   const sponsorLabel = typeof input.sponsorLabel === "string" ? input.sponsorLabel.trim() : "";
   const body = typeof input.body === "string" ? input.body.trim() : "";
   const placement = input.placement;
   const durationSeconds = input.durationSeconds;
   const rewardCoins = input.rewardCoins;
   const startsAtMs = input.startsAtMs;
   const endsAtMs = input.endsAtMs;
   const maxClaimsPerMember = input.maxClaimsPerMember;
   const rewardBudgetCoins = input.rewardBudgetCoins;
 
   if (title.length < 3 || title.length > 80 ||
       sponsorLabel.length < 2 || sponsorLabel.length > 60 ||
       body.length < 10 || body.length > 1200 ||
       (placement !== "reward_center" && placement !== "home") ||
       typeof durationSeconds !== "number" || !Number.isSafeInteger(durationSeconds) ||
-      durationSeconds < 15 || durationSeconds > MAX_AD_DURATION_SECONDS ||
+      durationSeconds < 1 ||
       typeof rewardCoins !== "number" || !Number.isSafeInteger(rewardCoins) ||
-      rewardCoins < 0 || rewardCoins > MAX_REWARD_COINS ||
+      rewardCoins < 0 ||
       typeof startsAtMs !== "number" || !Number.isSafeInteger(startsAtMs) || startsAtMs < 0 ||
       typeof endsAtMs !== "number" || !Number.isSafeInteger(endsAtMs) || endsAtMs <= startsAtMs ||
       typeof maxClaimsPerMember !== "number" || !Number.isSafeInteger(maxClaimsPerMember) ||
-      maxClaimsPerMember < 1 || maxClaimsPerMember > 100 ||
+      maxClaimsPerMember < 1 ||
       typeof rewardBudgetCoins !== "number" || !Number.isSafeInteger(rewardBudgetCoins) ||
-      rewardBudgetCoins < rewardCoins || rewardBudgetCoins > MAX_AD_BUDGET_COINS) {
+      rewardBudgetCoins < rewardCoins) {
     throw new Error("AD_CAMPAIGN_INVALID");
   }
   return {
     title, sponsorLabel, body,
     placement,
     durationSeconds,
     rewardCoins,
     startsAtMs,
     endsAtMs,
     maxClaimsPerMember,
     rewardBudgetCoins,
   };
 }
 
 export const AD_HEARTBEAT_MAX_GAP_MS = 15_000;
 
 /** Only short, sequential foreground intervals may add eligible viewing time. */
 export function eligibleHeartbeatDelta(
   previousHeartbeatAtMs: number | null,
   nowMs: number,
   sequence: number,
   expectedSequence: number,
   foreground: boolean,
   visible: boolean,
 ): { deltaMs: number; nextHeartbeatAtMs: number | null; nextSequence: number; paused: boolean } {
   if (!Number.isSafeInteger(nowMs) || nowMs < 0 ||
       !Number.isSafeInteger(sequence) || sequence < 1 ||
       sequence !== expectedSequence) {
     throw new Error("AD_HEARTBEAT_SEQUENCE_INVALID");
   }
   if (!foreground || !visible) {
     return { deltaMs: 0, nextHeartbeatAtMs: null, nextSequence: sequence + 1, paused: true };
   }
   if (previousHeartbeatAtMs === null) {
     return { deltaMs: 0, nextHeartbeatAtMs: nowMs, nextSequence: sequence + 1, paused: false };
   }
   const elapsed = nowMs - previousHeartbeatAtMs;
   if (elapsed <= 0) throw new Error("AD_HEARTBEAT_TIME_INVALID");
   if (elapsed > AD_HEARTBEAT_MAX_GAP_MS) {
     // A missed/late heartbeat earns no time; a fresh foreground interval must begin.
     return { deltaMs: 0, nextHeartbeatAtMs: nowMs, nextSequence: sequence + 1, paused: true };
   }
   return { deltaMs: elapsed, nextHeartbeatAtMs: nowMs, nextSequence: sequence + 1, paused: false };
 }
 /**
  * Collision-resistant per-member/per-campaign counter identity.
  * The former concatenated UID/campaign key was ambiguous when both contained underscores.
  */
 export function timedAdMemberCounterId(uid: string, campaignId: string): string {
   if (typeof uid !== "string" || uid.length < 1 || uid.length > 128 ||
       typeof campaignId !== "string" || !/^[A-Za-z0-9_-]{8,80}$/.test(campaignId)) {
     throw new Error("TIMED_AD_COUNTER_ID_INVALID");
   }
   return createHash("sha256")
     .update("mawdda-timed-ad-member-counter-v1:" + uid + ":" + campaignId)
     .digest("hex");
 }
diff --git a/functions/src/featured-ad-finance.ts b/functions/src/featured-ad-finance.ts
new file mode 100644
index 00000000..ad1df67f
--- /dev/null
+++ b/functions/src/featured-ad-finance.ts
@@ -0,0 +1,206 @@
+import { createHash } from "node:crypto";
+
+export type FeaturedAdFinancialAction =
+  | "payment_received"
+  | "refund_recorded"
+  | "settlement_reconciled"
+  | "review_completed";
+
+export interface FeaturedAdFinancialEventInput {
+  campaignId: string;
+  action: FeaturedAdFinancialAction;
+  idempotencyKey: string;
+  amountMinor: number | null;
+  currency: string | null;
+  externalReference: string | null;
+  evidenceReference: string | null;
+  note: string;
+  reviewOutcome: "approved" | "needs_attention" | null;
+}
+
+export interface FeaturedAdFinancialSnapshot {
+  currency: string | null;
+  receivedMinor: number;
+  refundedMinor: number;
+  reconciledMinor: number;
+  reviewStatus: "not_reviewed" | "in_review" | "reconciled" | "needs_review";
+  paymentStatus: "unpaid" | "paid" | "partially_refunded" | "refunded";
+}
+
+export class FeaturedAdFinancialValidationError extends Error {
+  constructor(readonly code: string) {
+    super(code);
+    this.name = "FeaturedAdFinancialValidationError";
+  }
+}
+
+function requiredText(value: unknown, min: number, max: number, code: string): string {
+  if (typeof value !== "string") throw new FeaturedAdFinancialValidationError(code);
+  const result = value.trim();
+  if (result.length < min || result.length > max) throw new FeaturedAdFinancialValidationError(code);
+  return result;
+}
+
+export function validateFeaturedAdFinancialEvent(value: unknown): FeaturedAdFinancialEventInput {
+  if (!value || typeof value !== "object" || Array.isArray(value)) {
+    throw new FeaturedAdFinancialValidationError("invalid_financial_event");
+  }
+  const input = value as Record<string, unknown>;
+  const campaignId = requiredText(input.campaignId, 8, 80, "invalid_campaign_id");
+  if (!/^[A-Za-z0-9_-]{8,80}$/.test(campaignId)) {
+    throw new FeaturedAdFinancialValidationError("invalid_campaign_id");
+  }
+  const action = input.action;
+  if (action !== "payment_received" && action !== "refund_recorded" &&
+      action !== "settlement_reconciled" && action !== "review_completed") {
+    throw new FeaturedAdFinancialValidationError("invalid_financial_action");
+  }
+  const idempotencyKey = requiredText(input.idempotencyKey, 16, 100, "invalid_idempotency_key");
+  if (!/^[A-Za-z0-9_-]{16,100}$/.test(idempotencyKey)) {
+    throw new FeaturedAdFinancialValidationError("invalid_idempotency_key");
+  }
+  const note = requiredText(input.note, 5, 1500, "invalid_financial_note");
+  const externalReference = requiredText(input.externalReference, 3, 160, "invalid_external_reference");
+  const evidenceReference = input.evidenceReference == null
+    ? null : requiredText(input.evidenceReference, 3, 500, "invalid_evidence_reference");
+  const amountMinor = input.amountMinor == null ? null : input.amountMinor;
+  const currency = input.currency == null ? null : input.currency;
+  const reviewOutcome = input.reviewOutcome == null ? null : input.reviewOutcome;
+  if (action === "review_completed") {
+    if (amountMinor !== null || currency !== null || reviewOutcome !== "approved" && reviewOutcome !== "needs_attention") {
+      throw new FeaturedAdFinancialValidationError("invalid_review_decision");
+    }
+  } else {
+    if (typeof amountMinor !== "number" || !Number.isSafeInteger(amountMinor) ||
+        amountMinor < 1 || amountMinor > Number.MAX_SAFE_INTEGER ||
+        typeof currency !== "string" || !/^[A-Z]{3}$/.test(currency) ||
+        reviewOutcome !== null) {
+      throw new FeaturedAdFinancialValidationError("invalid_financial_amount");
+    }
+  }
+  if ((action === "refund_recorded" || action === "payment_received") && evidenceReference === null) {
+    throw new FeaturedAdFinancialValidationError("financial_evidence_required");
+  }
+  return {
+    campaignId, action, idempotencyKey, amountMinor, currency,
+    externalReference, evidenceReference, note, reviewOutcome: reviewOutcome as FeaturedAdFinancialEventInput["reviewOutcome"],
+  };
+}
+
+export function applyFeaturedAdFinancialEvent(
+  current: FeaturedAdFinancialSnapshot,
+  event: FeaturedAdFinancialEventInput,
+): FeaturedAdFinancialSnapshot {
+  // Re-validate at the state-transition boundary. TypeScript types do not
+  // protect runtime callers, deserialized data, or future server adapters.
+  event = validateFeaturedAdFinancialEvent(event);
+  const safe = (value: number): number => {
+    if (!Number.isSafeInteger(value) || value < 0) {
+      throw new FeaturedAdFinancialValidationError("financial_snapshot_corrupt");
+    }
+    return value;
+  };
+  const receivedMinor = safe(current.receivedMinor);
+  const refundedMinor = safe(current.refundedMinor);
+  const reconciledMinor = safe(current.reconciledMinor);
+  if (current.currency !== null && (typeof current.currency !== "string" || !/^[A-Z]{3}$/.test(current.currency))) {
+    throw new FeaturedAdFinancialValidationError("financial_snapshot_corrupt");
+  }
+  if (!["not_reviewed", "in_review", "reconciled", "needs_review"].includes(current.reviewStatus) ||
+      !["unpaid", "paid", "partially_refunded", "refunded"].includes(current.paymentStatus) ||
+      (receivedMinor === 0) !== (current.currency === null) ||
+      (receivedMinor === 0 && (refundedMinor !== 0 || reconciledMinor !== 0 ||
+        current.paymentStatus !== "unpaid")) ||
+      (receivedMinor > 0 && current.paymentStatus !==
+        (refundedMinor === 0 ? "paid" : refundedMinor === receivedMinor ? "refunded" : "partially_refunded"))) {
+    throw new FeaturedAdFinancialValidationError("financial_snapshot_corrupt");
+  }
+  const netReceived = receivedMinor - refundedMinor;
+  if (refundedMinor > receivedMinor) {
+    throw new FeaturedAdFinancialValidationError("financial_snapshot_inconsistent");
+  }
+  if (event.action === "payment_received") {
+    if (current.currency !== null && current.currency !== event.currency) {
+      throw new FeaturedAdFinancialValidationError("payment_currency_conflict");
+    }
+    const nextReceived = receivedMinor + event.amountMinor!;
+    if (!Number.isSafeInteger(nextReceived) || nextReceived > Number.MAX_SAFE_INTEGER) {
+      throw new FeaturedAdFinancialValidationError("financial_amount_overflow");
+    }
+    const nextNetReceived = nextReceived - refundedMinor;
+    return {
+      currency: event.currency,
+      receivedMinor: nextReceived,
+      refundedMinor,
+      reconciledMinor,
+      reviewStatus: "in_review",
+      paymentStatus: refundedMinor === 0 ? "paid"
+        : nextNetReceived === 0 ? "refunded" : "partially_refunded",
+    };
+  }
+  if (event.action === "refund_recorded") {
+    if (current.currency !== event.currency || receivedMinor === 0 ||
+        event.amountMinor! > netReceived) {
+      throw new FeaturedAdFinancialValidationError("refund_exceeds_unrefunded_receipt");
+    }
+    const nextRefunded = refundedMinor + event.amountMinor!;
+    const nextNetReceived = receivedMinor - nextRefunded;
+    return {
+      currency: current.currency,
+      receivedMinor,
+      refundedMinor: nextRefunded,
+      // Reconciliation is the currently matched net balance, not a cash transfer.
+      // A refund reduces that matched balance and forces a fresh owner review.
+      reconciledMinor: Math.min(reconciledMinor, nextNetReceived),
+      reviewStatus: "needs_review",
+      paymentStatus: nextRefunded === receivedMinor ? "refunded" : "partially_refunded",
+    };
+  }
+  if (event.action === "settlement_reconciled") {
+    if (current.currency !== event.currency || receivedMinor === 0 ||
+        reconciledMinor > netReceived || event.amountMinor! > netReceived - reconciledMinor) {
+      throw new FeaturedAdFinancialValidationError("settlement_exceeds_unreconciled_balance");
+    }
+    const nextReconciled = reconciledMinor + event.amountMinor!;
+    return {
+      currency: current.currency,
+      receivedMinor,
+      refundedMinor,
+      reconciledMinor: nextReconciled,
+      reviewStatus: nextReconciled === netReceived ? "reconciled" : "in_review",
+      paymentStatus: current.paymentStatus,
+    };
+  }
+  if (event.reviewOutcome === "needs_attention") {
+    return { ...current, reviewStatus: "needs_review" };
+  }
+  if (receivedMinor === 0 || refundedMinor > receivedMinor || reconciledMinor > netReceived) {
+    throw new FeaturedAdFinancialValidationError("financial_review_cannot_be_approved");
+  }
+  return {
+    ...current,
+    reviewStatus: reconciledMinor === netReceived ? "reconciled" : "in_review",
+  };
+}
+
+/** Hash the external reference so arbitrary client text never becomes a Firestore document path. */
+export function featuredAdFinancialIdempotencyId(
+  campaignId: string,
+  action: FeaturedAdFinancialAction,
+  externalReference: string,
+): string {
+  if (!/^[A-Za-z0-9_-]{8,80}$/.test(campaignId) ||
+      !["payment_received", "refund_recorded", "settlement_reconciled", "review_completed"].includes(action) ||
+      typeof externalReference !== "string" || externalReference.length < 3 || externalReference.length > 160) {
+    throw new FeaturedAdFinancialValidationError("invalid_idempotency_identity");
+  }
+  // The external statement/reference is stable across app retries and devices.
+  return createHash("sha256").update(campaignId + ":" + action + ":" + externalReference).digest("hex");
+}
+
+export function defaultFeaturedAdFinancialSnapshot(): FeaturedAdFinancialSnapshot {
+  return {
+    currency: null, receivedMinor: 0, refundedMinor: 0, reconciledMinor: 0,
+    reviewStatus: "not_reviewed", paymentStatus: "unpaid",
+  };
+}
diff --git a/functions/src/group-call-economy.ts b/functions/src/group-call-economy.ts
new file mode 100644
index 00000000..e50738b2
--- /dev/null
+++ b/functions/src/group-call-economy.ts
@@ -0,0 +1,141 @@
+export type GroupCallMode = "audio" | "video";
+
+export type GroupCallPricingPolicy = {
+  policyId: string;
+  version: number;
+  active: boolean;
+  audioCoinsPerMinute: number;
+  videoCoinsPerMinute: number;
+  updatedAtMs: number;
+};
+
+export type GroupCallCoinShare = { uid: string; amount: number };
+
+export function validateGroupCallPricingPolicy(value: unknown): GroupCallPricingPolicy {
+  if (!value || typeof value !== "object" || Array.isArray(value)) {
+    throw new Error("INVALID_GROUP_CALL_PRICING_POLICY");
+  }
+  const p = value as Record<string, unknown>;
+  if (typeof p.policyId !== "string" || !/^[A-Za-z0-9_-]{8,100}$/.test(p.policyId) ||
+      !Number.isSafeInteger(p.version) || (p.version as number) < 1 ||
+      typeof p.active !== "boolean" ||
+      !Number.isSafeInteger(p.audioCoinsPerMinute) || (p.audioCoinsPerMinute as number) < 0 ||
+      !Number.isSafeInteger(p.videoCoinsPerMinute) || (p.videoCoinsPerMinute as number) < 0 ||
+      !Number.isSafeInteger(p.updatedAtMs) || (p.updatedAtMs as number) < 1 ||
+      (p.active && (p.audioCoinsPerMinute as number) < 1 && (p.videoCoinsPerMinute as number) < 1)) {
+    throw new Error("INVALID_GROUP_CALL_PRICING_POLICY");
+  }
+  return {
+    policyId: p.policyId,
+    version: p.version as number,
+    active: p.active,
+    audioCoinsPerMinute: p.audioCoinsPerMinute as number,
+    videoCoinsPerMinute: p.videoCoinsPerMinute as number,
+    updatedAtMs: p.updatedAtMs as number,
+  };
+}
+
+export function getGroupCallRate(policyInput: unknown, mode: GroupCallMode): number {
+  if (mode !== "audio" && mode !== "video") throw new Error("INVALID_GROUP_CALL_MODE");
+  const policy = validateGroupCallPricingPolicy(policyInput);
+  if (!policy.active) throw new Error("GROUP_CALL_PRICING_DISABLED");
+  const rate = mode === "audio" ? policy.audioCoinsPerMinute : policy.videoCoinsPerMinute;
+  if (rate < 1) throw new Error("GROUP_CALL_MODE_DISABLED");
+  return rate;
+}
+
+/**
+ * Splits one owner-priced call cost as evenly as integer coins permit.
+ * Remainder coins are assigned one each in stable UID order, never based on
+ * join time or initiator status. The sum is always exact and deterministic.
+ */
+export function calculateGroupCallCoinShares(
+  totalAmount: number,
+  participantUids: readonly string[],
+  initiatorUid: string,
+): GroupCallCoinShare[] {
+  if (!Number.isSafeInteger(totalAmount) || totalAmount <= 0 ||
+      typeof initiatorUid !== "string" || initiatorUid.trim().length < 1 ||
+      initiatorUid.length > 128 || !Array.isArray(participantUids) ||
+      participantUids.length < 2 ||
+      participantUids.some((uid) => typeof uid !== "string" || uid.trim().length < 1 || uid.length > 128) ||
+      new Set(participantUids).size !== participantUids.length ||
+      !participantUids.includes(initiatorUid)) {
+    throw new Error("INVALID_GROUP_CALL_SETTLEMENT_INPUT");
+  }
+  const orderedUids = [...participantUids].sort((a, b) => a.localeCompare(b));
+  const baseShare = Math.floor(totalAmount / orderedUids.length);
+  const remainder = totalAmount % orderedUids.length;
+  return orderedUids.map((uid, index) => ({
+    uid, amount: baseShare + (index < remainder ? 1 : 0),
+  }));
+}
+
+/** One settlement unit is one owner-configured minute for the actual active set. */
+export function calculateGroupCallBillingSlice(
+  policyInput: unknown,
+  mode: GroupCallMode,
+  activeParticipantUids: readonly string[],
+  initiatorUid: string,
+  billableMinutes: number,
+): { policyId: string; policyVersion: number; totalAmount: number; shares: GroupCallCoinShare[] } {
+  if (!Number.isSafeInteger(billableMinutes) || billableMinutes < 1 || billableMinutes > 1440) {
+    throw new Error("INVALID_GROUP_CALL_BILLABLE_MINUTES");
+  }
+  const policy = validateGroupCallPricingPolicy(policyInput);
+  const rate = getGroupCallRate(policy, mode);
+  const totalAmount = rate * billableMinutes;
+  if (!Number.isSafeInteger(totalAmount)) throw new Error("GROUP_CALL_AMOUNT_OUT_OF_RANGE");
+  return {
+    policyId: policy.policyId,
+    policyVersion: policy.version,
+    totalAmount,
+    shares: calculateGroupCallCoinShares(totalAmount, activeParticipantUids, initiatorUid),
+  };
+}
+
+
+/** Maximum per-member hold: a group always has at least two billable members. */
+export function calculateGroupCallMaximumReservation(
+  policyInput: unknown,
+  mode: GroupCallMode,
+  maxDurationMs: number,
+): { policyId: string; policyVersion: number; maxBillableMinutes: number; maxTotalAmount: number; perParticipantReserve: number } {
+  if (!Number.isSafeInteger(maxDurationMs) || maxDurationMs < 1 || maxDurationMs > 24 * 60 * 60 * 1000) {
+    throw new Error("INVALID_GROUP_CALL_MAX_DURATION");
+  }
+  const policy = validateGroupCallPricingPolicy(policyInput);
+  const maxBillableMinutes = Math.ceil(maxDurationMs / 60000);
+  const maxTotalAmount = getGroupCallRate(policy, mode) * maxBillableMinutes;
+  if (!Number.isSafeInteger(maxTotalAmount) || maxTotalAmount < 1) {
+    throw new Error("GROUP_CALL_AMOUNT_OUT_OF_RANGE");
+  }
+  return {
+    policyId: policy.policyId,
+    policyVersion: policy.version,
+    maxBillableMinutes,
+    maxTotalAmount,
+    perParticipantReserve: Math.ceil(maxTotalAmount / 2),
+  };
+}
+
+/** Final billing ignores each member's join time: every media-connected member shares the same total. */
+export function calculateGroupCallFinalSettlement(
+  policyInput: unknown,
+  mode: GroupCallMode,
+  mediaConnectedParticipantUids: readonly string[],
+  initiatorUid: string,
+  elapsedMs: number,
+  maxDurationMs: number,
+): { policyId: string; policyVersion: number; billableMinutes: number; totalAmount: number; shares: GroupCallCoinShare[] } {
+  if (!Number.isSafeInteger(elapsedMs) || elapsedMs < 0 ||
+      !Number.isSafeInteger(maxDurationMs) || maxDurationMs < 1) {
+    throw new Error("INVALID_GROUP_CALL_ELAPSED_DURATION");
+  }
+  const maxBillableMinutes = Math.ceil(maxDurationMs / 60000);
+  const billableMinutes = Math.max(1, Math.min(maxBillableMinutes, Math.ceil(elapsedMs / 60000)));
+  const slice = calculateGroupCallBillingSlice(
+    policyInput, mode, mediaConnectedParticipantUids, initiatorUid, billableMinutes,
+  );
+  return { ...slice, billableMinutes };
+}
