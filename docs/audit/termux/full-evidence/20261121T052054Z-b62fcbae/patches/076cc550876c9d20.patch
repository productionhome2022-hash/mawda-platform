+#!/usr/bin/env node
+"use strict";
+
+// Emulator-only test identity provisioner. Never points at a live Firebase project.
+const crypto = require("node:crypto");
+const fs = require("node:fs");
+const path = require("node:path");
+const { initializeApp, getApps } = require("firebase-admin/app");
+const { getAuth } = require("firebase-admin/auth");
+const { getFirestore, FieldValue } = require("firebase-admin/firestore");
+const catalogue = require("../test/fixtures/test-account-personas.json");
+
+function fail(message) {
+  console.error(`[mawdda-test-seed] REFUSED: ${message}`);
+  process.exit(1);
+}
+
+function resolveProjectId() {
+  if (process.env.GCLOUD_PROJECT) return process.env.GCLOUD_PROJECT;
+  if (process.env.GOOGLE_CLOUD_PROJECT) return process.env.GOOGLE_CLOUD_PROJECT;
+  if (process.env.FIREBASE_CONFIG) {
+    try {
+      const config = JSON.parse(process.env.FIREBASE_CONFIG);
+      return config.projectId || config.project_id || "";
+    } catch {
+      fail("FIREBASE_CONFIG is not valid JSON.");
+    }
+  }
+  return "";
+}
+
+const projectId = resolveProjectId();
+const requiredEmulators = catalogue.environmentPolicy.requiredEmulators;
+for (const variable of requiredEmulators) {
+  if (!process.env[variable]) fail(`${variable} is required.`);
+}
+if (!projectId.startsWith(catalogue.environmentPolicy.allowedProjectIdPrefix)) {
+  fail(`project id must start with ${catalogue.environmentPolicy.allowedProjectIdPrefix}; received ${projectId || "(empty)"}.`);
+}
+if (process.env.FUNCTIONS_EMULATOR !== "true" && process.env.MAWDDA_ALLOW_TEST_SEED !== "1") {
+  // firebase emulators:exec sets emulator hosts but not always FUNCTIONS_EMULATOR.
+  // An explicit opt-in is required to avoid accidental invocation from a developer shell.
+  fail("set MAWDDA_ALLOW_TEST_SEED=1 explicitly when running against the required emulators.");
+}
+
+const app = getApps()[0] || initializeApp({ projectId });
+const auth = getAuth(app);
+const db = getFirestore(app);
+const testEmailDomain = "test.mawdda.invalid";
+const outputPath = path.resolve(process.cwd(), ".mawdda-test-credentials.local.json");
+
+function randomPassword() {
+  return `Mw!${crypto.randomBytes(24).toString("base64url")}9a`;
+}
+
+async function ensureUser(persona) {
+  const email = `${persona.id}@${testEmailDomain}`;
+  const password = randomPassword();
+  const profileFixture = catalogue.profileFixtures?.[persona.id] || {};
+  const username = `${persona.id.replace(/[^a-z0-9]/g, "_")}_mawdda_test`;
+  let user;
+  try {
+    user = await auth.getUserByEmail(email);
+    user = await auth.updateUser(user.uid, {
+      password,
+      emailVerified: persona.emailVerified === true,
+      displayName: persona.displayName,
+      disabled: false,
+    });
+  } catch (error) {
+    if (error.code !== "auth/user-not-found") throw error;
+    user = await auth.createUser({
+      email,
+      password,
+      emailVerified: persona.emailVerified === true,
+      displayName: persona.displayName,
+      disabled: false,
+    });
+  }
+
+  // Never set platformOwner or biometricVerified claims/proof in the seeder.
+  // The emulator-only coin balance below is test fixture data, not a reward or payment.
+  // Privileged and verified states must be produced by their real server-side flows.
+  await db.collection("users").doc(user.uid).set({
+    uid: user.uid,
+    email,
+    memberId: user.uid,
+    displayName: persona.displayName,
+    fullName: persona.displayName,
+    username,
+    emailVerified: persona.emailVerified === true,
+    coins: 100000,
+    profileCompleted: true,
+    accountStatus: "active",
+    age: Number.isSafeInteger(profileFixture.age) ? profileFixture.age : 25,
+    profession: profileFixture.profession || "عضو تجريبي",
+    country: profileFixture.country || "Switzerland",
+    region: profileFixture.region || "Zurich",
+    gender: profileFixture.gender || "unspecified",
+    maritalStatus: profileFixture.maritalStatus || "unspecified",
+    bio: profileFixture.biography || "",
+    interests: Array.isArray(profileFixture.interests) ? profileFixture.interests : [],
+    goals: Array.isArray(profileFixture.goals) ? profileFixture.goals : [],
+    profileVisibility: profileFixture.profileVisibility || "public",
+    isTestAccount: true,
+    testPersonaId: persona.id,
+    createdAt: FieldValue.serverTimestamp(),
+    updatedAt: FieldValue.serverTimestamp(),
+  }, { merge: true });
+
+  await db.collection("usernameRegistry").doc(username).set({
+    uid: user.uid,
+    username,
+    isTestAccount: true,
+    createdAt: FieldValue.serverTimestamp(),
+  }, { merge: true });
+
+  await db.collection("testAccountProfiles").doc(persona.id).set({
+    schemaVersion: 1,
+    personaId: persona.id,
+    uid: user.uid,
+    displayName: persona.displayName,
+    accountKind: persona.accountKind,
+    emailVerifiedFixture: persona.emailVerified === true,
+    biometricFixture: persona.biometricFixture || false,
+    ownerAccess: persona.ownerAccess || false,
+    capabilities: persona.capabilities,
+    deniedCapabilities: persona.deniedCapabilities,
+    profile: {
+      ...profileFixture,
+      uniqueHandle: username,
+      avatarFixture: `fixture://avatars/${persona.id}`,
+      coverFixture: `fixture://covers/${persona.id}`,
+      accountState: "active-test-only",
+      badgesAndTitles: [],
+      shopEntitlements: [],
+      walletFixture: { coins: 100000, mode: "sandbox" },
+      roomPermissions: [],
+      notificationPreferences: { inApp: true, push: false, email: false },
+      testLabels: ["MAWDDA_TEST_ONLY", persona.id],
+    },
+    environment: { projectId, emulatorOnly: true },
+    updatedAt: FieldValue.serverTimestamp(),
+  }, { merge: true });
+
+  return { personaId: persona.id, uid: user.uid, email, password };
+}
+
+async function main() {
+  const results = [];
+  for (const persona of catalogue.personas) {
+    if (persona.id === "guest-preview") {
+      // A guest is created through Firebase anonymous sign-in in the client test flow.
+      // No password account is created for this persona.
+      await db.collection("testAccountProfiles").doc(persona.id).set({
+        schemaVersion: 1,
+        personaId: persona.id,
+        displayName: persona.displayName,
+        accountKind: "anonymous-client-flow",
+        guestWindow: persona.guestWindow,
+        profile: {
+          ...(catalogue.profileFixtures?.[persona.id] || {}),
+          uniqueHandle: "guest_preview_mawdda_test",
+          avatarFixture: "fixture://avatars/guest-preview",
+          coverFixture: "fixture://covers/guest-preview",
+          accountState: "active-test-only",
+          testLabels: ["MAWDDA_TEST_ONLY", persona.id],
+        },
+        capabilities: persona.capabilities,
+        deniedCapabilities: persona.deniedCapabilities,
+        environment: { projectId, emulatorOnly: true },
+        updatedAt: FieldValue.serverTimestamp(),
+      }, { merge: true });
+      continue;
+    }
+    results.push(await ensureUser(persona));
+  }
+
+  fs.writeFileSync(outputPath, JSON.stringify({
+    generatedAt: new Date().toISOString(),
+    projectId,
+    emulatorOnly: true,
+    accounts: results,
+  }, null, 2), { mode: 0o600 });
+  try { fs.chmodSync(outputPath, 0o600); } catch {}
+  console.log(`Provisioned ${results.length} emulator-only email identities and the guest profile fixture.`);
+  console.log(`Credentials written locally with owner-only permissions: ${outputPath}`);
+  console.log("No custom claims, biometric proof, wallet credits, rewards, or live payments were created.");
+}
+
+main().catch((error) => {
+  console.error("[mawdda-test-seed] failed:", error);
+  process.exitCode = 1;
+});
diff --git a/functions/test/feature-coverage-matrix.test.js b/functions/test/feature-coverage-matrix.test.js
new file mode 100644
index 00000000..b4999f3c
--- /dev/null
+++ b/functions/test/feature-coverage-matrix.test.js
@@ -0,0 +1,103 @@
+const test = require("node:test");
+const assert = require("node:assert/strict");
+const fs = require("node:fs");
+const path = require("node:path");
+const matrix = require("./fixtures/feature-coverage-matrix.json");
+const catalogue = require("./fixtures/test-account-personas.json");
+const packageJson = require("../package.json");
+
+test("coverage matrix references only provisioned personas", () => {
+  const ids = new Set(catalogue.personas.map((persona) => persona.id));
+  for (const [group, actors] of Object.entries(matrix.personas)) {
+    assert.ok(Array.isArray(actors), `persona group ${group} must be an array`);
+    for (const actor of actors) assert.ok(ids.has(actor), `unknown actor ${actor}`);
+  }
+  for (const journey of matrix.journeys) {
+    assert.ok(journey.id && journey.area && journey.cases.length > 0);
+    for (const actor of journey.actors) assert.ok(ids.has(actor), `${journey.id}: unknown actor ${actor}`);
+  }
+});
+
+test("every journey maps to an executable npm script", () => {
+  for (const journey of matrix.journeys) {
+    if (journey.command === "npm test") {
+      assert.ok(packageJson.scripts.test, `${journey.id}: missing npm test script`);
+      continue;
+    }
+    const match = journey.command.match(/^npm run ([a-z0-9:_-]+)$/);
+    assert.ok(match, `${journey.id}: invalid command declaration`);
+    assert.ok(packageJson.scripts[match[1]], `${journey.id}: missing npm script ${match[1]}`);
+  }
+});
+
+
+test("guest journey status does not overstate unimplemented room/session behavior", () => {
+  const guest = matrix.journeys.find((journey) => journey.id === "GUEST-001");
+  assert.ok(guest);
+  assert.equal(guest.status, "partial");
+  assert.ok(guest.cases.includes("anonymous-guest-privacy-acknowledgement"));
+  assert.ok(guest.plannedCases.includes("public-room-text-send-receive"));
+  assert.ok(guest.plannedCases.includes("public-room-audio-send-receive"));
+  assert.ok(guest.plannedCases.includes("60-minute-expiry"));
+  assert.match(guest.releaseBlocker, /not implemented/i);
+});
+
+test("full member personas share the ordinary baseline while biometric adds only its dedicated capability", () => {
+  const [emailId, biometricId, counterpartyId] = matrix.personas.fullMembers;
+  const personaFor = (id) => {
+    const persona = catalogue.personas.find((entry) => entry.id === id);
+    assert.ok(persona, `missing persona ${id}`);
+    assert.equal(persona.ownerAccess, false);
+    assert.ok(persona.deniedCapabilities.includes("owner.console"));
+    return new Set(persona.capabilities);
+  };
+  const baseline = personaFor(emailId);
+  const biometric = personaFor(biometricId);
+  const counterparty = personaFor(counterpartyId);
+
+  for (const capability of baseline) {
+    assert.ok(biometric.has(capability), `biometric member missing baseline capability ${capability}`);
+    assert.ok(counterparty.has(capability), `counterparty member missing baseline capability ${capability}`);
+  }
+  assert.deepEqual(
+    [...counterparty].filter((capability) => !baseline.has(capability)),
+    [],
+    "counterparty must have the ordinary member baseline without extra privileges",
+  );
+  assert.deepEqual(
+    [...biometric].filter((capability) => !baseline.has(capability)),
+    ["biometric.challengeFlow"],
+    "biometric persona may add only its dedicated verification test capability",
+  );
+});
+
+test("test environment preserves hard security and financial invariants", () => {
+  assert.equal(matrix.environment, "firebase-emulator-only");
+  assert.equal(matrix.policy.ordinaryMemberGetsAllMemberFeatures, true);
+  assert.equal(matrix.policy.ownerPrivilegesRequireRealMfaFlow, true);
+  assert.equal(matrix.policy.testClockMayOnlyBeOverriddenInEmulator, true);
+  assert.equal(matrix.policy.paymentMode, "sandbox-only");
+  assert.equal(matrix.policy.biometricRewardRequiresServerVerification, true);
+  assert.equal(matrix.policy.financialWritesMustUseServerTransactions, true);
+  assert.deepEqual(matrix.policy.memberMediaDeny, ["pdf", "documents"]);
+  assert.ok(matrix.policy.ownerMediaAllow.includes("pdf"));
+});
+
+test("release gates cover client, backend, device, security and pilot readiness", () => {
+  for (const gate of [
+    "backend-build", "backend-unit-tests", "firestore-storage-rules",
+    "all-emulator-integration-journeys", "flutter-analyze", "flutter-tests",
+    "flutter-web-release-build", "real-device-biometric",
+    "real-device-camera-microphone", "owner-mfa-review", "security-review",
+    "manual-acceptance-review", "staging-smoke-tests", "explicit-pilot-approval",
+  ]) assert.ok(matrix.releaseGates.includes(gate), `missing release gate ${gate}`);
+});
+
+test("every journey has a unique ID and a repeatable non-empty scenario list", () => {
+  const ids = matrix.journeys.map((journey) => journey.id);
+  assert.equal(new Set(ids).size, ids.length);
+  for (const journey of matrix.journeys) {
+    assert.equal(new Set(journey.cases).size, journey.cases.length, journey.id);
+    assert.ok(journey.cases.every((scenario) => typeof scenario === "string" && scenario.length > 0));
+  }
+});
