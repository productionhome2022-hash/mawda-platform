diff --git a/functions/test/integration/test-persona-interaction.integration.test.js b/functions/test/integration/test-persona-interaction.integration.test.js
new file mode 100644
index 00000000..94c0ecbd
--- /dev/null
+++ b/functions/test/integration/test-persona-interaction.integration.test.js
@@ -0,0 +1,104 @@
+const test = require("node:test");
+const assert = require("node:assert/strict");
+const { getFirestore } = require("firebase-admin/firestore");
+const { getAuth } = require("firebase-admin/auth");
+const { transferCoins } = require("../../lib/index");
+
+const db = getFirestore();
+const suffix = () => `${Date.now()}_${Math.random().toString(36).slice(2, 10)}`;
+
+test("seeded Mawdda member personas can transact with each other inside the isolated lab", async () => {
+  assert.ok(process.env.FIRESTORE_EMULATOR_HOST, "Firestore emulator is required");
+  assert.ok(process.env.FIREBASE_AUTH_EMULATOR_HOST, "Auth emulator is required");
+  const [senderProfile, recipientProfile] = await Promise.all([
+    db.collection("testAccountProfiles").doc("email-member").get(),
+    db.collection("testAccountProfiles").doc("counterparty-member").get(),
+  ]);
+  assert.ok(senderProfile.exists, "email-member fixture must be provisioned first");
+  assert.ok(recipientProfile.exists, "counterparty-member fixture must be provisioned first");
+  const senderUid = senderProfile.data().uid;
+  const recipientUid = recipientProfile.data().uid;
+  assert.ok(senderUid && recipientUid && senderUid !== recipientUid);
+
+  const senderRef = db.collection("users").doc(senderUid);
+  const recipientRef = db.collection("users").doc(recipientUid);
+  const settingsRef = db.doc("platformSettings/coinTransfers");
+  const previousSettings = await settingsRef.get();
+  const previousSettingsData = previousSettings.exists ? previousSettings.data() : null;
+  const senderBefore = (await senderRef.get()).data();
+  const recipientBefore = (await recipientRef.get()).data();
+  const [senderAuth, recipientAuth] = await Promise.all([
+    getAuth().getUser(senderUid), getAuth().getUser(recipientUid),
+  ]);
+  assert.equal(senderBefore.isTestAccount, true);
+  assert.equal(recipientBefore.isTestAccount, true);
+  assert.equal(senderBefore.testPersonaId, "email-member");
+  assert.equal(recipientBefore.testPersonaId, "counterparty-member");
+  assert.equal(senderAuth.emailVerified, true);
+  assert.equal(recipientAuth.emailVerified, true);
+  assert.equal((senderProfile.data().profile.walletFixture).coins, senderBefore.coins);
+  assert.equal((recipientProfile.data().profile.walletFixture).coins, recipientBefore.coins);
+
+  const tag = suffix();
+  const requestId = `persona_transfer_${tag}`;
+  const transferId = `${senderUid}_${requestId}`;
+  const senderLedgerRef = senderRef.collection("walletLedger").doc(transferId);
+  const recipientLedgerRef = recipientRef.collection("walletLedger").doc(transferId);
+  const platformLedgerRef = db.collection("platformWalletLedger").doc(transferId);
+  const transferRef = db.collection("coinTransfers").doc(transferId);
+  const senderBalance = senderBefore.coins;
+  const recipientBalance = recipientBefore.coins;
+
+  await settingsRef.set({ enabled: true, commissionBps: 1000, version: 1 });
+  try {
+    const response = await transferCoins.run({
+      data: {
+        recipientUid,
+        amount: 1000,
+        requestId,
+        expectedCommissionBps: 1000,
+      },
+      auth: {
+        uid: senderUid,
+        token: { firebase: { sign_in_provider: "password" } },
+      },
+    });
+    assert.equal(response.grossAmount, 1000);
+    assert.equal(response.commissionAmount, 100);
+    assert.equal(response.netAmount, 900);
+    assert.equal(response.idempotentReplay, false);
+
+    const [senderAfter, recipientAfter, senderLedger, recipientLedger, platformLedger, transfer] =
+      await Promise.all([
+        senderRef.get(), recipientRef.get(), senderLedgerRef.get(),
+        recipientLedgerRef.get(), platformLedgerRef.get(), transferRef.get(),
+      ]);
+    assert.equal(senderAfter.data().coins, senderBalance - 1000);
+    assert.equal(recipientAfter.data().coins, recipientBalance + 900);
+    assert.equal(senderLedger.data().recipientUid, recipientUid);
+    assert.equal(senderLedger.data().commissionAmount, 100);
+    assert.equal(recipientLedger.data().senderUid, senderUid);
+    assert.equal(recipientLedger.data().amount, 900);
+    assert.equal(platformLedger.data().amount, 100);
+    assert.equal(transfer.data().status, "completed");
+
+    const replay = await transferCoins.run({
+      data: { recipientUid, amount: 1000, requestId, expectedCommissionBps: 1000 },
+      auth: { uid: senderUid, token: { firebase: { sign_in_provider: "password" } } },
+    });
+    assert.equal(replay.idempotentReplay, true);
+    assert.equal((await senderRef.get()).data().coins, senderBalance - 1000);
+    assert.equal((await recipientRef.get()).data().coins, recipientBalance + 900);
+  } finally {
+    await Promise.all([
+      senderRef.update({ coins: senderBalance }),
+      recipientRef.update({ coins: recipientBalance }),
+      senderLedgerRef.delete().catch(() => undefined),
+      recipientLedgerRef.delete().catch(() => undefined),
+      platformLedgerRef.delete().catch(() => undefined),
+      transferRef.delete().catch(() => undefined),
+    ]);
+    if (previousSettingsData) await settingsRef.set(previousSettingsData);
+    else await settingsRef.delete().catch(() => undefined);
+  }
+});
diff --git a/functions/test/test-account-personas.test.js b/functions/test/test-account-personas.test.js
new file mode 100644
index 00000000..21dfa987
--- /dev/null
+++ b/functions/test/test-account-personas.test.js
@@ -0,0 +1,92 @@
+const test = require("node:test");
+const assert = require("node:assert/strict");
+const personas = require("./fixtures/test-account-personas.json");
+
+test("test persona catalogue has unique stable IDs and complete profile requirements", () => {
+  const ids = personas.personas.map((persona) => persona.id);
+  assert.equal(new Set(ids).size, ids.length);
+  for (const field of personas.profileFixtureRequirements) assert.ok(field.length > 0);
+  for (const persona of personas.personas) {
+    assert.ok(persona.displayName);
+    assert.ok(Array.isArray(persona.capabilities));
+    assert.ok(Array.isArray(persona.deniedCapabilities));
+    assert.equal(persona.capabilities.some((capability) => persona.deniedCapabilities.includes(capability)), false);
+  }
+});
+
+test("guest persona has one hour per rolling 24 hours and limited public-room participation", () => {
+  const guest = personas.personas.find((persona) => persona.id === "guest-preview");
+  assert.ok(guest);
+  assert.deepEqual(guest.guestWindow, { durationSeconds: 3600, rollingWindowSeconds: 86400, emulatorClockOverrideOnly: true });
+  assert.deepEqual(guest.capabilities, [
+    "browse.publicMemberDiscovery", "browse.publicShopCatalog", "browse.publicAds",
+    "rooms.public.join", "chat.publicRooms.text.send", "chat.publicRooms.text.receive", "chat.publicRooms.audio.send", "chat.publicRooms.audio.receive"
+  ]);
+  assert.deepEqual(personas.guestPolicy, {
+    durationSeconds: 3600,
+    rollingWindowSeconds: 86400,
+    allowedRoomTypes: ["public"],
+    allowedRoomActions: ["join", "sendTextMessage", "sendAudioMessage", "receiveTextMessage", "receiveAudioMessage"],
+    deniedRoomActions: ["joinPrivateRoom", "rentRoom", "moderateRoom", "sendGift"],
+    allowedMessageTypes: ["text", "audio"],
+    deniedMessageTypes: ["image", "gif", "video", "pdf", "document", "file"],
+    directMessagesAllowed: false,
+    emulatorClockOverrideOnly: true
+  });
+  assert.ok(guest.deniedCapabilities.includes("wallet.write"));
+  assert.ok(guest.deniedCapabilities.includes("store.purchase"));
+  assert.ok(guest.deniedCapabilities.includes("chat.direct.send"));
+  assert.ok(guest.deniedCapabilities.includes("chat.privateRooms.join"));
+  assert.ok(guest.deniedCapabilities.includes("media.image"));
+  assert.ok(guest.deniedCapabilities.includes("media.gif"));
+  assert.ok(guest.deniedCapabilities.includes("media.video"));
+  assert.ok(guest.deniedCapabilities.includes("media.documents"));
+});
+
+test("email and biometric member personas cannot inherit owner authority", () => {
+  for (const id of ["email-member", "biometric-member"]) {
+    const persona = personas.personas.find((item) => item.id === id);
+    assert.ok(persona);
+    assert.equal(persona.emailVerified, true);
+    assert.equal(persona.ownerAccess, false);
+    assert.ok(persona.deniedCapabilities.includes("owner.console"));
+  }
+});
+
+test("owner test persona requires MFA and cannot mutate production", () => {
+  const owner = personas.personas.find((persona) => persona.id === "owner-operator");
+  assert.ok(owner);
+  assert.equal(owner.ownerAccess, "mfa-required-no-bypass");
+  assert.ok(owner.deniedCapabilities.includes("owner.actionWithoutMfa"));
+  assert.ok(owner.deniedCapabilities.includes("productionOwnerMutation"));
+});
+
+test("member media policy denies documents while preserving owner-only document exchange", () => {
+  assert.deepEqual(personas.mediaPolicy.memberDenied, ["pdf", "documents"]);
+  assert.ok(personas.mediaPolicy.ownerAllowed.includes("pdf"));
+});
+
+test("payments remain sandbox-only and biometric fixture is not hardware proof", () => {
+  assert.equal(personas.paymentPolicy.liveChargesAllowed, false);
+  assert.equal(personas.biometricPolicy.emulatorFixtureIsNotHardwareProof, true);
+  assert.equal(personas.biometricPolicy.grantRewardsOnlyAfterAuthoritativeServerVerification, true);
+});
+test("every persona has a complete, age-safe isolated profile fixture", () => {
+  const handles = [];
+  for (const persona of personas.personas) {
+    const profile = personas.profileFixtures[persona.id];
+    assert.ok(profile, `missing profile fixture for ${persona.id}`);
+    assert.ok(profile.biography.length >= 20);
+    assert.equal(profile.locale, "ar");
+    assert.ok(profile.country);
+    assert.ok(profile.region);
+    if (persona.id !== "guest-preview") {
+      assert.ok(profile.age >= 18, `member fixture ${persona.id} must be adult-scoped`);
+      assert.ok(profile.profession);
+      assert.ok(profile.interests.length >= 2);
+    }
+    if (persona.id === "owner-operator") assert.equal(profile.profileVisibility, "private");
+    handles.push(`${persona.id.replace(/[^a-z0-9]/g, "_")}_mawdda_test`);
+  }
+  assert.equal(new Set(handles).size, handles.length);
+});
