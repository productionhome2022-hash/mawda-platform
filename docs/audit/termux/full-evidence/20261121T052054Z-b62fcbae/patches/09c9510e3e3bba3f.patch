+export const getMyDirectChats = onCall(async (request) => {
+  const uid = requireAuthenticatedUid(request.auth?.uid);
+  const userSnapshot = await db.collection("users").doc(uid).get();
+  const currentUser = userSnapshot.data() ?? {};
