+
+    try {
+      const snapshot = await db.collection("adminAuditLogs")
+        .where("auditChainId", "==", "owner-review-v1")
+        .where("auditSequence", ">", previousSequence)
+        .orderBy("auditSequence", "asc")
+        .limit(OWNER_AUDIT_ARCHIVE_BATCH_SIZE + 1)
+        .get();
