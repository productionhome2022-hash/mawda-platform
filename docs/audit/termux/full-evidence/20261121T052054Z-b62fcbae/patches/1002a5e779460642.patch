   if (!Buffer.isBuffer(buffer) || buffer.length < 16) {
     throw new Error("BIOMETRIC_VIDEO_CONTAINER_INVALID");
   }
   const movie = findAtom(buffer, 0, buffer.length, "mvhd", CONTAINER_ATOMS);
