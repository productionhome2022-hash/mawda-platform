+    await ref.update({
+      status: "upload_rejected", uploadFailureCode: failureCode,
+      evidenceDeletionStatus: "pending",
+      evidenceDeletionRetryAt: Timestamp.fromMillis(Date.now()),
+      updatedAt: FieldValue.serverTimestamp(),
+    });
