+  const expectedVideoOriginal = "quarantine/" + uid + "/" + videoMediaId;
+  const expectedAudioSafe = "processed/" + uid + "/" + audioMediaId + "/audio.mp3";
+  const expectedVideoSafe = "processed/" + uid + "/" + videoMediaId + "/video.mp4";
