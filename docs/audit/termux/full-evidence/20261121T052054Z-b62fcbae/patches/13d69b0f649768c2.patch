+const test = require("node:test");
+const assert = require("node:assert/strict");
+const {
+  CALL_ENTITLEMENT_ITEM_IDS,
+  hasActiveCallEntitlement,
+} = require("../lib/call-entitlements");
+
+const now = 1_800_000_000_000;
+const active = (itemId, category, expiresAt = now + 60_000) => ({
+  itemId,
+  data: { itemId, category, status: "active", expiresAt: new Date(expiresAt) },
+});
+
+test("audio and video calls require a matching active entitlement", () => {
+  assert.equal(hasActiveCallEntitlement("audio", [active("voice_call_24h", "voice_call")], now), true);
+  assert.equal(hasActiveCallEntitlement("video", [active("video_call_7d", "video_call")], now), true);
+  assert.equal(hasActiveCallEntitlement("audio", [active("video_call_24h", "video_call")], now), false);
+  assert.equal(hasActiveCallEntitlement("video", [active("voice_call_24h", "voice_call")], now), false);
+});
+
+test("call entitlement fails closed for expired, missing-expiry, inactive and forged records", () => {
+  assert.equal(hasActiveCallEntitlement("audio", [active("voice_call_24h", "voice_call", now)], now), false);
+  assert.equal(hasActiveCallEntitlement("audio", [{
+    itemId: "voice_call_24h",
+    data: { itemId: "voice_call_24h", category: "voice_call", status: "active" },
+  }], now), false);
+  assert.equal(hasActiveCallEntitlement("audio", [{
+    itemId: "voice_call_24h",
+    data: { itemId: "voice_call_24h", category: "voice_call", status: "revoked", expiresAt: new Date(now + 1000) },
+  }], now), false);
+  assert.equal(hasActiveCallEntitlement("audio", [{
+    itemId: "voice_call_24h",
+    data: { itemId: "video_call_24h", category: "voice_call", status: "active", expiresAt: new Date(now + 1000) },
+  }], now), false);
+});
+
+test("all three owner-configured entitlement periods are recognized", () => {
+  assert.deepEqual(CALL_ENTITLEMENT_ITEM_IDS.audio, ["voice_call_24h", "voice_call_7d", "voice_call_30d"]);
+  assert.deepEqual(CALL_ENTITLEMENT_ITEM_IDS.video, ["video_call_24h", "video_call_7d", "video_call_30d"]);
+  assert.equal(hasActiveCallEntitlement("audio", [active("voice_call_30d", "voice_call")], now), true);
+  assert.equal(hasActiveCallEntitlement("video", [active("video_call_30d", "video_call")], now), true);
+});
diff --git a/functions/test/call-usage-policy.test.js b/functions/test/call-usage-policy.test.js
new file mode 100644
index 00000000..3181c19d
--- /dev/null
+++ b/functions/test/call-usage-policy.test.js
@@ -0,0 +1,64 @@
+const test = require("node:test");
+const assert = require("node:assert/strict");
+const {
+  validateCallUsagePolicy, callModeQuotaLimit, callMaxDurationEnd,
+} = require("../lib/call-usage-policy");
+
+const policy = {
+  active: true,
+  quotaWindowMs: 86400000,
+  audioCallsPerWindow: 5,
+  videoCallsPerWindow: 3,
+  maxCallDurationMs: 300000,
+};
+
+test("validates owner-set call quotas and duration without supplying defaults", () => {
+  assert.deepEqual(validateCallUsagePolicy(policy), policy);
+  assert.throws(() => validateCallUsagePolicy(undefined), /CALL_USAGE_POLICY_INVALID/);
+  assert.throws(() => validateCallUsagePolicy({ ...policy, audioCallsPerWindow: -1 }));
+  assert.throws(() => validateCallUsagePolicy({ ...policy, quotaWindowMs: 1 }));
+  assert.throws(() => validateCallUsagePolicy({ ...policy, maxCallDurationMs: 1000 }));
+});
+
+test("owner can disable a call mode or leave its quota unlimited", () => {
+  const configured = validateCallUsagePolicy({
+    ...policy, audioCallsPerWindow: 0, videoCallsPerWindow: null,
+    maxCallDurationMs: null,
+  });
+  assert.equal(callModeQuotaLimit(configured, "audio"), 0);
+  assert.equal(callModeQuotaLimit(configured, "video"), null);
+  assert.equal(callMaxDurationEnd(1000, configured), 301000);
+  assert.throws(() => callModeQuotaLimit(configured, "other"));
+});
+
+test("direct-call duration is fixed at five minutes by the approved call ceiling", () => {
+  assert.equal(callMaxDurationEnd(1000, validateCallUsagePolicy(policy), "direct", "audio"), 301000);
+  assert.equal(callMaxDurationEnd(1000, validateCallUsagePolicy(policy), "direct", "video"), 301000);
+  assert.equal(callMaxDurationEnd(1000, validateCallUsagePolicy({
+    ...policy, maxCallDurationMs: null,
+  }), "direct", "video"), 301000);
+});
+
+test("group audio duration is fixed at five minutes regardless of owner duration policy", () => {
+  assert.equal(callMaxDurationEnd(1000, validateCallUsagePolicy({
+    ...policy, maxCallDurationMs: 60000,
+  }), "room", "audio"), 301000);
+  assert.equal(callMaxDurationEnd(1000, validateCallUsagePolicy({
+    ...policy, maxCallDurationMs: null,
+  }), "room", "audio"), 301000);
+});
+
+test("group video duration is fixed at five minutes regardless of owner duration policy", () => {
+  assert.equal(callMaxDurationEnd(1000, validateCallUsagePolicy({
+    ...policy, maxCallDurationMs: 60000,
+  }), "room", "video"), 301000);
+  assert.equal(callMaxDurationEnd(1000, validateCallUsagePolicy({
+    ...policy, maxCallDurationMs: null,
+  }), "room", "video"), 301000);
+});
+
+test("group-call duration rejects an unknown mode and scope", () => {
+  const configured = validateCallUsagePolicy(policy);
+  assert.throws(() => callMaxDurationEnd(1000, configured, "room", "other"));
+  assert.throws(() => callMaxDurationEnd(1000, configured, "other"));
+});
diff --git a/functions/test/group-call-economy.test.js b/functions/test/group-call-economy.test.js
new file mode 100644
index 00000000..bc57ebc5
--- /dev/null
+++ b/functions/test/group-call-economy.test.js
@@ -0,0 +1,97 @@
+const test = require("node:test");
+const assert = require("node:assert/strict");
+const {
+  validateGroupCallPricingPolicy, getGroupCallRate,
+  calculateGroupCallCoinShares, calculateGroupCallBillingSlice,
+  calculateGroupCallMaximumReservation, calculateGroupCallFinalSettlement,
+} = require("../lib/group-call-economy.js");
+
+const policy = {
+  policyId: "owner-policy-2026",
+  version: 7,
+  active: true,
+  audioCoinsPerMinute: 137,
+  videoCoinsPerMinute: 293,
+  updatedAtMs: 1795000000000,
+};
+
+test("owner policy is versioned and rates are read from policy, never hard-coded", () => {
+  assert.equal(getGroupCallRate(policy, "audio"), 137);
+  assert.equal(getGroupCallRate(policy, "video"), 293);
+  assert.equal(validateGroupCallPricingPolicy(policy).version, 7);
+});
+
+test("missing, inactive, malformed or zero active rates fail closed", () => {
+  assert.throws(() => validateGroupCallPricingPolicy(null));
+  assert.throws(() => getGroupCallRate({ ...policy, active: false }, "audio"), /DISABLED/);
+  assert.throws(() => validateGroupCallPricingPolicy({ ...policy, audioCoinsPerMinute: 0, videoCoinsPerMinute: 0 }));
+  assert.throws(() => validateGroupCallPricingPolicy({ ...policy, version: 0 }));
+});
+
+test("owner can independently disable one call mode without inventing a price", () => {
+  const audioOnly = { ...policy, videoCoinsPerMinute: 0 };
+  assert.equal(getGroupCallRate(audioOnly, "audio"), policy.audioCoinsPerMinute);
+  assert.throws(() => getGroupCallRate(audioOnly, "video"), /MODE_DISABLED/);
+  const videoOnly = { ...policy, audioCoinsPerMinute: 0 };
+  assert.equal(getGroupCallRate(videoOnly, "video"), policy.videoCoinsPerMinute);
+  assert.throws(() => getGroupCallRate(videoOnly, "audio"), /MODE_DISABLED/);
+  assert.throws(() => getGroupCallRate(policy, "unknown"), /INVALID_GROUP_CALL_MODE/);
+});
+
+test("unknown runtime call modes are rejected", () => {
+  assert.throws(() => getGroupCallRate(policy, "screen"), /INVALID_GROUP_CALL_MODE/);
+});
+
+test("integer allocation is balanced and assigns the rounding remainder to the initiator", () => {
+  const a = calculateGroupCallCoinShares(101, ["owner", "b", "c"], "owner");
+  const b = calculateGroupCallCoinShares(101, ["c", "owner", "b"], "owner");
+  assert.deepEqual(a, b);
+  assert.deepEqual(a.map((item) => item.amount), [33, 33, 35]);
+  assert.equal(a.reduce((sum, item) => sum + item.amount, 0), 101);
+  assert.equal(a.find((item) => item.uid === "owner").amount, 35);
+});
+
+test("participant shares depend on final participant count and initiator bears the remainder", () => {
+  const four = calculateGroupCallCoinShares(2000, ["owner", "early", "late", "last-second"], "owner");
+  assert.deepEqual(four.map((item) => item.amount), [500, 500, 500, 500]);
+  const three = calculateGroupCallCoinShares(2000, ["owner", "early", "late"], "owner");
+  assert.deepEqual(three.map((item) => item.amount), [666, 666, 668]);
+  const two = calculateGroupCallCoinShares(2000, ["owner", "late"], "owner");
+  assert.deepEqual(two.map((item) => item.amount), [1000, 1000]);
+});
+
+test("billing slice freezes owner policy version and charges actual active participants", () => {
+  const result = calculateGroupCallBillingSlice(policy, "audio", ["owner", "b", "c"], "owner", 2);
+  assert.equal(result.policyId, policy.policyId);
+  assert.equal(result.policyVersion, policy.version);
+  assert.equal(result.totalAmount, 274);
+  assert.equal(result.shares.reduce((sum, item) => sum + item.amount, 0), result.totalAmount);
+});
+
+test("integer allocation handles participant counts larger than whole-coin total deterministically", () => {
+  const shares = calculateGroupCallCoinShares(1, ["owner", "b", "c", "d"], "owner");
+  assert.deepEqual(shares.map((item) => item.amount), [0, 0, 0, 1]);
+  assert.equal(shares.reduce((sum, item) => sum + item.amount, 0), 1);
+});
+
+test("maximum reservation and final settlement charge late joiners equally", () => {
+  const reserve = calculateGroupCallMaximumReservation(policy, "video", 3 * 60 * 1000);
+  assert.equal(reserve.maxBillableMinutes, 3);
+  assert.equal(reserve.maxTotalAmount, 879);
+  assert.equal(reserve.perParticipantReserve, 440);
+  const result = calculateGroupCallFinalSettlement(
+    policy, "video", ["owner", "early", "late", "last-second"], "owner",
+    15 * 1000, 3 * 60 * 1000,
+  );
+  assert.equal(result.billableMinutes, 1);
+  assert.equal(result.totalAmount, 293);
+  assert.deepEqual(result.shares.map((item) => item.amount), [73, 73, 73, 74]);
+  assert.equal(result.shares.reduce((sum, item) => sum + item.amount, 0), 293);
+});
+
+test("invalid participant sets and invalid duration fail closed", () => {
+  assert.throws(() => calculateGroupCallCoinShares(10, ["owner", "owner"], "owner"));
+  assert.throws(() => calculateGroupCallCoinShares(10, ["b", "c"], "owner"));
+  assert.throws(() => calculateGroupCallBillingSlice(policy, "video", ["owner", "b"], "owner", 0));
+  assert.throws(() => calculateGroupCallBillingSlice(policy, "video", ["owner", "b"], "owner", 1441));
+});
