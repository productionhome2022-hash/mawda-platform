+  required BuildContext context,
+  required MemberMediaUploadService service,
+}) {
+  return showModalBottomSheet<Map<String, dynamic>>(
+    context: context,
+    isScrollControlled: true,
+    useSafeArea: true,
+    builder: (_) => _MawddaStickerPicker(service: service),
+  );
+}
+
