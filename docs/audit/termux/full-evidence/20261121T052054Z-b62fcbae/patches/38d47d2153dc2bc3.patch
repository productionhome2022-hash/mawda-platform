         // shop, but leave charging disabled until the owner confirms prices.
         active: fulfillmentReady,
         purchaseEnabled: false,
         fulfillmentReady,
         createdAt: FieldValue.serverTimestamp(),
         updatedAt: FieldValue.serverTimestamp(),
