+                                  child: FutureBuilder<String>(
+                                    future: _assetUrl(packId, stickerId),
+                                    builder: (context, imageSnapshot) {
+                                      if (imageSnapshot.connectionState == ConnectionState.waiting) {
+                                        return const Center(
+                                          child: SizedBox(
+                                            width: 20,
+                                            height: 20,
+                                            child: CircularProgressIndicator(strokeWidth: 2),
