     const roomRef = db.collection("rooms").doc(event.roomId);
     const roomSnapshot = await transaction.get(roomRef);
     const ownerSession = hasPlatformOwnerSession(
       (request.auth?.token ?? {}) as Record<string, unknown>,
       undefined,
       uid,
