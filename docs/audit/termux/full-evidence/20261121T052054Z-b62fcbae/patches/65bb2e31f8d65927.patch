+++ b/functions/test/biometric-review-state.test.js
@@ -0,0 +1,13 @@
+const test=require("node:test");const assert=require("node:assert/strict");
+const {createInitialBiometricReview,decideBiometricReview,startBiometricRetry}=require("../lib/biometric-review-state");
+const owner="super_owner_uid_0001",member="member_uid_00001";const id=n=>"request_identifier_"+n;const month=(y,m,d=15)=>Date.UTC(y,m,d,10);
+test("first rejection opens attempt two after one calendar month",()=>{const a=createInitialBiometricReview({requestId:id(1),uid:member,submittedAtMs:month(2026,0,15)});const r=decideBiometricReview({state:a,decision:"rejected",reviewerUid:owner,decidedAtMs:month(2026,0,31)});assert.equal(r.nextEligibleAtMs,month(2026,1,28));assert.throws(()=>startBiometricRetry({state:r,nextRequestId:id(2),submittedAtMs:r.nextEligibleAtMs-1}),/NOT_ELIGIBLE/);assert.equal(startBiometricRetry({state:r,nextRequestId:id(2),submittedAtMs:r.nextEligibleAtMs}).attemptNumber,2);});
+test("second rejection allows one final attempt after another calendar month",()=>{const a=createInitialBiometricReview({requestId:id(1),uid:member,submittedAtMs:month(2026,0,1)});const r1=decideBiometricReview({state:a,decision:"rejected",reviewerUid:owner,decidedAtMs:month(2026,0,31)});const b=startBiometricRetry({state:r1,nextRequestId:id(2),submittedAtMs:r1.nextEligibleAtMs});const r2=decideBiometricReview({state:b,decision:"rejected",reviewerUid:owner,decidedAtMs:month(2026,1,28)});assert.equal(r2.nextEligibleAtMs,month(2026,2,28));assert.equal(startBiometricRetry({state:r2,nextRequestId:id(3),submittedAtMs:r2.nextEligibleAtMs}).attemptNumber,3);});
+test("third rejection permanently closes sequence with no fourth attempt",()=>{let s=createInitialBiometricReview({requestId:id(1),uid:member,submittedAtMs:month(2026,0,1)});for(let n=1;n<=3;n++){if(n>1)s=startBiometricRetry({state:s,nextRequestId:id(n),submittedAtMs:s.nextEligibleAtMs});s=decideBiometricReview({state:s,decision:"rejected",reviewerUid:owner,decidedAtMs:month(2026,n-1,15)});}assert.equal(s.status,"closed");assert.equal(s.finalRejection,true);assert.equal(s.nextEligibleAtMs,null);assert.throws(()=>startBiometricRetry({state:s,nextRequestId:id(4),submittedAtMs:month(2026,3,15)}),/NOT_ELIGIBLE/);});
+test("acceptance is terminal and member cannot review own request",()=>{const s=createInitialBiometricReview({requestId:id(1),uid:member,submittedAtMs:month(2026,0,1)});const a=decideBiometricReview({state:s,decision:"accepted",reviewerUid:owner,decidedAtMs:month(2026,0,2)});assert.equal(a.status,"accepted");assert.throws(()=>decideBiometricReview({state:a,decision:"rejected",reviewerUid:owner,decidedAtMs:month(2026,0,3)}));assert.throws(()=>decideBiometricReview({state:s,decision:"accepted",reviewerUid:member,decidedAtMs:month(2026,0,2)}));});
+
+test("malformed persisted state cannot create an attempt beyond the three-attempt cap",()=>{
+ const rejected=createInitialBiometricReview({requestId:id(1),uid:member,submittedAtMs:month(2026,0,1)});
+ const forged={...rejected,status:"rejected",attemptNumber:3,decidedAtMs:month(2026,0,2),decidedByUid:owner,nextEligibleAtMs:month(2026,1,2),finalRejection:false};
+ assert.throws(()=>startBiometricRetry({state:forged,nextRequestId:id(4),submittedAtMs:forged.nextEligibleAtMs}),/STATE_INVALID|NOT_ELIGIBLE/);
+});
