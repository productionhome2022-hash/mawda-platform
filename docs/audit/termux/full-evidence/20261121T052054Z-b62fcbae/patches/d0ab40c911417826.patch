 } as const;
 
 export interface FeaturedAdRewardPolicy {
   enabled: boolean;
   rewardCoinsPerView: number;
   maxRewardedViewsPerUtcDay: number;
   maxRewardCoinsPerUtcDay: number;
   maxRewardsPerCampaignRolling24h: number;
