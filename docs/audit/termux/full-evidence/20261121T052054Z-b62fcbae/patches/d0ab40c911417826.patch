 }
 
 export type FeaturedAdRewardDecision =
   | { eligible: true; amountCoins: number; reason: "qualified" }
   | {
       eligible: false;
       amountCoins: 0;
       reason:
         | "policy_disabled"
         | "campaign_ineligible"
         | "budget_unavailable"
