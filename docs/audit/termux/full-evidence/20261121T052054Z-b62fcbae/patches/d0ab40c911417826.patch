   }
 
   return {
     creatorDisplayName,
     creatorCategory,
     platformName,
     sourceType,
     contentUrl,
     proposalTitle,
     proposalDescription,
     audienceDescription,
     proposedDuration,
     targetGeographies,
     quoteRequested,
     proposedBudgetAmount,
     currency,
     rightsConfirmed: true,
     idempotencyKey,
   };
 }
