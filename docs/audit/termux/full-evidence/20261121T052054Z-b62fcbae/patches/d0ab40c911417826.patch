+        content: Text('تم الإهداء. وصل للمستلم ${receipt.netAmount} BetaCoins.'),
+      ));
+    } on FirebaseFunctionsException catch (error) {
+      if (mounted) setState(() => _error = error.message ?? 'تعذر إتمام الإهداء.');
