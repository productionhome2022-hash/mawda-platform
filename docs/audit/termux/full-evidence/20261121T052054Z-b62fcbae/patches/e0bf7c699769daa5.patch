+++ b/functions/test/platform-role-identities.test.js
@@ -0,0 +1,41 @@
+const test = require("node:test");
+const assert = require("node:assert/strict");
+const {
+  PLATFORM_ROLE_CAPACITY, platformRoleDisplayLabel, nextPermanentRoleOrdinal, assertPlatformRoleCapacity,
+} = require("../lib/platform-role-identities");
+
+test("general Admin sequence is open-ended and monotonic", () => {
+  assert.equal(PLATFORM_ROLE_CAPACITY.platform_admin, null);
+  assert.equal(nextPermanentRoleOrdinal([1, 2, 7]), 8);
+  assert.equal(platformRoleDisplayLabel("platform_admin", 8), "Admin 8");
+  assert.equal(platformRoleDisplayLabel("platform_admin", 2, "ar"), "أدمن ٢");
+});
+
+test("Admin Media and general production each have five independent seats", () => {
+  assert.equal(PLATFORM_ROLE_CAPACITY.ad_general_supervisor, 5);
+  assert.equal(PLATFORM_ROLE_CAPACITY.production_general_supervisor, 5);
+  assert.equal(platformRoleDisplayLabel("ad_general_supervisor", 1), "Admin Media 1");
+  assert.equal(platformRoleDisplayLabel("production_general_supervisor", 5, "ar"), "مشرف إنتاج عام ٥");
+  assert.throws(() => platformRoleDisplayLabel("ad_general_supervisor", 6), /CAPACITY_EXCEEDED/);
+});
+
+test("Team Production Supervisor is open-ended and distinct", () => {
+  assert.equal(PLATFORM_ROLE_CAPACITY.production_supervisor, null);
+  assert.equal(platformRoleDisplayLabel("production_supervisor", 12), "Team Production Supervisor 12");
+  assert.equal(platformRoleDisplayLabel("production_supervisor", 1, "ar"), "مشرف إنتاج الفريق ١");
+});
+
+test("role seat capacity guard blocks a sixth Admin Media or general production supervisor", () => {
+  assert.doesNotThrow(() => assertPlatformRoleCapacity("ad_general_supervisor", 5));
+  assert.doesNotThrow(() => assertPlatformRoleCapacity("production_general_supervisor", 5));
+  assert.throws(() => assertPlatformRoleCapacity("ad_general_supervisor", 6), /CAPACITY_EXCEEDED/);
+  assert.throws(() => assertPlatformRoleCapacity("production_general_supervisor", 6), /CAPACITY_EXCEEDED/);
+  assert.doesNotThrow(() => assertPlatformRoleCapacity("platform_admin", 1000));
+  assert.doesNotThrow(() => assertPlatformRoleCapacity("production_supervisor", 1000));
+  assert.throws(() => assertPlatformRoleCapacity("platform_admin", -1), /ACTIVE_COUNT_INVALID/);
+});
+
+test("sequence history rejects corrupt ordinals and never reuses removed slots", () => {
+  assert.throws(() => nextPermanentRoleOrdinal([1, 0]), /HISTORY_INVALID/);
+  assert.equal(nextPermanentRoleOrdinal([1, 2, 4]), 5);
+});
diff --git a/functions/test/platform-terminology-docs.test.js b/functions/test/platform-terminology-docs.test.js
new file mode 100644
index 00000000..7524fc39
--- /dev/null
+++ b/functions/test/platform-terminology-docs.test.js
@@ -0,0 +1,39 @@
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+
+const repoRoot = path.resolve(__dirname, '../..');
+const canonicalDocs = [
+  'docs/MAWADDA_PRODUCT_CONSTITUTION.md',
+  'docs/MAWADDA_COMPREHENSIVE_PRODUCT_VISION_2026.md',
+  'docs/MAWADDA_APPROVED_DECISIONS_AND_TRACEABILITY.md',
+  'docs/MAWADDA_BRAND_AND_PRODUCT_EXPERIENCE.md',
+  'docs/SEVEN_PHASE_EXECUTION_PLAN.md',
+  'docs/STRUCTURAL_GOVERNANCE_AND_BIOMETRIC_VERIFICATION_2026-11-19.md',
+  'docs/MAWADDA_CANONICAL_ADMIN_TERMINOLOGY.md',
+];
+const legacyOwnerLabels = [/Super Admin Owner/i, /Super Admin/i, /السوبر أدمن/i, /سوبر أدمن/i, /السوبر اونر/i, /سوبر اونر/i];
+
+test('canonical governance documents use one owner and supervisor terminology', () => {
+  const contents = canonicalDocs.map((relativePath) => {
+    const absolutePath = path.join(repoRoot, relativePath);
+    assert.ok(fs.existsSync(absolutePath), `Missing canonical document: ${relativePath}`);
+    return [relativePath, fs.readFileSync(absolutePath, 'utf8')];
+  });
+
+  for (const [relativePath, text] of contents) {
+    for (const pattern of legacyOwnerLabels) {
+      assert.doesNotMatch(text, pattern, `${relativePath} contains a deprecated owner label`);
+    }
+    assert.match(text, /Super Owner/, `${relativePath} must name the canonical platform owner`);
+    assert.match(text, /Admin Media 1.?5|Admin Media/, `${relativePath} must preserve the Admin Media identity`);
+    assert.match(text, /مشرف إنتاج عام/, `${relativePath} must preserve the general production supervisor identity`);
+    assert.match(text, /مشرف إنتاج الفريق/, `${relativePath} must preserve the team production supervisor identity`);
+  }
+});
+
+test('README links the canonical administrative terminology source', () => {
+  const readme = fs.readFileSync(path.join(repoRoot, 'README.md'), 'utf8');
+  assert.match(readme, /docs\/MAWADDA_CANONICAL_ADMIN_TERMINOLOGY\.md/);
+});
