+        requestId, status: data.status, rewardCoins: ledgerSnapshot.exists ? BIOMETRIC_REWARD_BETACOINS : 0,
+        idempotentReplay: true, uid, audioObjectPath: data.audioObjectPath,
+        videoObjectPath: data.videoObjectPath,
+      };
