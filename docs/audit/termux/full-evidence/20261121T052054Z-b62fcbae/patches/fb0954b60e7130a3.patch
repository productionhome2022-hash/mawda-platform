+      decision: decision as "accept" | "reject",
+      actorIsSuperOwner: true,
+      nowMs: Date.now(),
+    });
+    const nowMs = Date.now();
+    const decidedAt = Timestamp.fromMillis(nowMs);
+    const storedBalance = user.coins;
