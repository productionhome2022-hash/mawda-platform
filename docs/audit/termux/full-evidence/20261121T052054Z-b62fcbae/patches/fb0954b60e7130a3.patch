+              title: const Text('أوافق على تسجيل الصوت والفيديو واستخدامهما لمراجعة طلب التوثيق وفق سياسة الخصوصية الموضحة أعلاه.'),
+              controlAffinity: ListTileControlAffinity.leading,
+            ),
+            FilledButton.icon(
