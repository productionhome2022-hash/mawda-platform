rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Member profile documents are server-managed until field-level
    // profile update callables are implemented and tested.
    match /users/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow list, create, update, delete: if false;

      match /walletLedger/{entryId} {
        allow get, list: if signedIn() && request.auth.uid == userId;
        allow create, update, delete: if false;
      }
    }

    match /coinTransfers/{transferId} {
      allow get: if signedIn() &&
        (resource.data.senderUid == request.auth.uid ||
         resource.data.recipientUid == request.auth.uid);
      allow list, create, update, delete: if false;
    }

    // Platform financial records, settings, owner audit logs and
    // all not-yet-implemented collections are server-only / denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
