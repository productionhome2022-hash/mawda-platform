{
  "name": "mawda-platform-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "npm run build && node --check scripts/bootstrap-owner.cjs && node --test test/*.test.js",
    "bootstrap:owner": "node scripts/bootstrap-owner.cjs",
    "test:rules": "firebase emulators:exec --config ../firebase.json --only firestore,storage --project demo-mawda-rules \"node --test test/rules/*.test.js\"",
    "test:media-integration": "firebase emulators:exec --config ../firebase.json --only firestore --project demo-mawda-media \"node --test test/integration/media-callables.integration.test.js\""
  },
  "dependencies": {
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.0.0"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.0.0",
    "firebase-tools": "^14.0.0"
  }
}
