{
  "schemaVersion": 1,
  "environment": "firebase-emulator-only",
  "policy": {
    "ordinaryMemberGetsAllMemberFeatures": true,
    "ownerPrivilegesRequireRealMfaFlow": true,
    "guestRestrictionsRemainEnforced": true,
    "testClockMayOnlyBeOverriddenInEmulator": true,
    "paymentMode": "sandbox-only",
    "memberMediaAllow": [
      "image",
      "gif",
      "audio",
      "video"
    ],
    "memberMediaDeny": [
      "pdf",
      "documents"
    ],
    "ownerMediaAllow": [
      "image",
      "gif",
      "audio",
      "video",
      "pdf",
      "documents",
      "otherMedia"
    ],
    "biometricRewardRequiresServerVerification": true,
    "financialWritesMustUseServerTransactions": true,
    "guestSession": {
      "durationSeconds": 3600,
      "rollingWindowSeconds": 86400,
      "publicRoomsOnly": true,
      "allowedMessageTypes": [
        "text",
        "audio"
      ],
      "directMessagesAllowed": false,
      "privateRoomsAllowed": false,
      "emulatorClockOverrideOnly": true
    }
  },
  "personas": {
    "guest": [
      "guest-preview"
    ],
    "fullMembers": [
      "email-member",
      "biometric-member",
      "counterparty-member"
    ],
    "owner": [
      "owner-operator"
    ]
  },
  "journeys": [
    {
      "id": "AUTH-001",
      "area": "authentication",
      "actors": [
        "email-member",
        "counterparty-member"
      ],
      "command": "npm test",
      "cases": [
        "sign-in",
        "sign-out",
        "invalid-credentials",
        "expired-session",
        "email-verification-gate",
        "account-disabled"
      ]
    },
    {
      "id": "GUEST-001",
      "area": "guest",
      "actors": [
        "guest-preview"
      ],
      "command": "npm run test:guest-session-integration",
      "status": "partial",
      "cases": [
        "guest-minimal-profile-no-age",
        "server-session-start-and-idempotency",
        "general-audience-public-room-discovery",
        "public-room-join",
        "public-room-text-send-receive",
        "text-message-idempotency",
        "adult-and-private-room-denial",
        "session-end-and-cooldown-denial",
        "owner-explicit-general-audience-approval",
        "public-room-audio-attachment-send-receive",
        "direct-message-denial",
        "store-purchase-denial",
        "member-block-operation-denial"
      ],
      "plannedCases": [
        "real-device-audio-recording-and-playback",
        "60-minute-live-expiry-clock-integration",
        "cross-installation-abuse-resistance",
        "full-flutter-ui-to-backend-e2e",
        "no-rewards",
        "no-direct-messages",
        "no-private-rooms",
        "no-wallet",
        "no-purchase",
        "no-room-rental",
        "no-gifts",
        "no-image-gif-video-or-document-messages"
      ],
      "releaseBlocker": "Guest profile, server session, general-audience public-room join and text messaging are implemented in the development branch with emulator coverage. Full Flutter UI/device E2E, audio pipeline acceptance, exhaustive denied-capability matrix and cross-installation anti-abuse assurance remain release blockers."
    },
    {
      "id": "PROFILE-001",
      "area": "profiles",
      "actors": [
        "email-member",
        "biometric-member",
        "counterparty-member"
      ],
      "command": "npm run test:premium-profile-integration",
      "cases": [
        "create",
        "edit",
        "avatar",
        "cover",
        "bio",
        "privacy",
        "interests",
        "badges",
        "titles",
        "premium-entitlements",
        "analytics",
        "pinned-sections",
        "greeting",
        "discovery-boost",
        "block-and-report",
        "account-state"
      ]
    },
    {
      "id": "CHAT-001",
      "area": "messaging",
      "actors": [
        "email-member",
        "counterparty-member"
      ],
      "command": "npm run test:message-deletion-integration",
      "cases": [
        "direct-chat",
        "send-receive",
        "delivery-and-read",
        "reactions",
        "blocking",
        "reporting",
        "delete-for-me",
        "delete-for-everyone",
        "idempotency",
        "retention",
        "legal-hold"
      ]
    },
    {
      "id": "MEDIA-001",
      "area": "media",
      "actors": [
        "email-member",
        "counterparty-member",
        "owner-operator"
      ],
      "command": "npm run test:media-integration",
      "cases": [
        "image",
        "gif",
        "audio",
        "video",
        "mime-validation",
        "size-quota",
        "malware-quarantine",
        "approved-preview",
        "unauthorized-download",
        "member-pdf-denied",
        "owner-document-allowed",
        "retention",
        "legal-hold",
        "deletion"
      ]
    },
    {
      "id": "WALLET-001",
      "area": "wallet-and-coins",
      "actors": [
        "email-member",
        "counterparty-member",
        "owner-operator"
      ],
      "command": "npm run test:wallet-store-integration",
      "cases": [
        "balance-read",
        "ledger-read",
        "member-cannot-write-balance",
        "two-party-transfer",
        "sender-fee",
        "recipient-net-amount",
        "shared-transfer-id",
        "duplicate-replay",
        "insufficient-funds",
        "gift-send-receive",
        "sandbox-topup",
        "manual-purchase-request",
        "owner-verification",
        "audit-log"
      ]
    },
    {
      "id": "STORE-001",
      "area": "stores-and-entitlements",
      "actors": [
        "email-member",
        "biometric-member",
        "counterparty-member",
        "owner-operator"
      ],
      "command": "npm run test:wallet-store-integration",
      "cases": [
        "catalogue",
        "item-details",
        "purchase",
        "insufficient-balance",
        "duplicate-purchase",
        "entitlement-grant",
        "entitlement-revoke",
        "premium-store",
        "avatar-frames",
        "animated-names",
        "profile-themes",
        "vip",
        "badges",
        "titles",
        "analytics",
        "discovery-boost"
      ]
    },
    {
      "id": "ROOM-001",
      "area": "rooms",
      "actors": [
        "email-member",
        "counterparty-member",
        "owner-operator"
      ],
      "command": "npm run test:room-rental-integration",
      "cases": [
        "public-room-rent",
        "private-room-rent",
        "owner-invite",
        "join",
        "leave",
        "roles",
        "moderation",
        "billing",
        "expiry",
        "renewal",
        "concurrent-rent",
        "room-events",
        "audit"
