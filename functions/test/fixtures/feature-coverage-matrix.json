      ]
    }
  ],
  "releaseGates": [
    "backend-build",
    "backend-unit-tests",
    "firestore-storage-rules",
    "all-emulator-integration-journeys",
    "flutter-analyze",
    "flutter-tests",
    "flutter-web-release-build",
    "real-device-biometric",
    "real-device-camera-microphone",
    "owner-mfa-review",
    "security-review",
    "manual-acceptance-review",
