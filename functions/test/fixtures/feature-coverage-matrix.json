    },
    {
      "id": "RULES-001",
      "area": "authorization-and-data-isolation",
      "actors": [
        "guest-preview",
        "email-member",
        "biometric-member",
        "counterparty-member",
        "owner-operator"
      ],
      "command": "npm run test:rules",
      "cases": [
